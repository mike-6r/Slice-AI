# API mode is the default. Set this to "mock" only for explicit isolated UI development.
VITE_DATA_SOURCE=api
# Public API origin. The client adds the /api/v1 path itself.
VITE_API_BASE_URL=http://127.0.0.1:3001
# Optional editorial placement. This is a real published Asset ID or slug served by the API.
# Leave empty to render the honest Featured asset unavailable state.
VITE_FEATURED_ASSET_ID=
# Must exactly match the server's current configured policy references.
# Development labels are not final legal documents.
VITE_TERMS_POLICY_VERSION=terms-development-v1
VITE_PRIVACY_POLICY_VERSION=privacy-development-v1
