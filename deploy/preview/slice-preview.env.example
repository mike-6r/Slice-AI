# Slice preview only. This file is a template—copy it to
# /etc/slice/slice-preview.env and replace values through the server's secret
# manager. Do not use this file for the existing root-path staging services.

NODE_ENV=development
APP_ENV=beta
SLICE_DEPLOYMENT_CHANNEL=preview
SLICE_PUBLIC_BASE_PATH=/preview

HOST=127.0.0.1
PORT=3201
SLICE_WEB_HOST=127.0.0.1
SLICE_WEB_PORT=3202
TRUST_PROXY_HOPS=1

APP_PUBLIC_URL=https://staging.slicecollectable.com/preview
CORS_ORIGINS=https://staging.slicecollectable.com
VITE_DATA_SOURCE=api
VITE_APP_ENV=beta
VITE_DEPLOYMENT_CHANNEL=preview
VITE_PUBLIC_BASE_PATH=/preview
VITE_API_BASE_URL=https://staging.slicecollectable.com/preview

# Dedicated preview data only. The preview service must never use the staging
# database, the default Redis DB, or the staging Redis key prefix.
DATABASE_URL=postgresql://slice_preview:REPLACE_WITH_SECRET@127.0.0.1:5432/slice_preview?schema=public
REDIS_URL=redis://:REPLACE_WITH_SECRET@127.0.0.1:6380/1
REDIS_KEY_PREFIX=slice:preview:

JWT_ACCESS_SECRET=REPLACE_WITH_A_PREVIEW_ONLY_32_PLUS_CHARACTER_SECRET
JWT_ISSUER=slice-preview-api
JWT_AUDIENCE=slice-preview-web
REFRESH_COOKIE_NAME=slice_preview_refresh
REFRESH_COOKIE_PATH=/preview/api/v1/auth
COOKIE_SECURE=true
# Leave COOKIE_DOMAIN unset. The cookie is host-only and cannot be shared by
# configuration with another host.

# Preview is read-safe only: no live payments, workers, market data providers,
# deposits, withdrawals, trading, realtime, or listing operations.
PROVIDER_MODE=local
STRIPE_LIVE_ENABLED=false
STRIPE_IDENTITY_ENABLED=false
XIMILAR_ENABLED=false
XIMILAR_CARD_GRADING_ENABLED=false
PRICECHARTING_ENABLED=false
OUTBOX_WORKER_ENABLED=false
MARKET_REFRESH_WORKER_ENABLED=false
OPERATIONAL_TRADING_ENABLED=false
OPERATIONAL_DEPOSITS_ENABLED=false
OPERATIONAL_WITHDRAWALS_ENABLED=false
OPERATIONAL_REALTIME_ENABLED=false
OPERATIONAL_LISTING_ENABLED=false

# The normal application validation still applies. Use preview-only values for
# every value below; never copy secrets from an existing staging environment.
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_A_PREVIEW_ONLY_32_PLUS_CHARACTER_SECRET
EMAIL_DELIVERY_MODE=local_test
EMAIL_ENABLED=true
PHONE_VERIFICATION_ENABLED=false
PHONE_DELIVERY_MODE=local_test
TWILIO_SMS_ENABLED=false
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=local_test
SIGNUP_CONSENT_REQUIRED=true
TERMS_POLICY_VERSION=terms-preview-v1
PRIVACY_POLICY_VERSION=privacy-preview-v1
LOCAL_SUBMISSION_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=LOCAL
