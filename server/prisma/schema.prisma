model User {
  id                                  String                             @id @default(cuid())
  email                               String                             @unique
  normalizedEmail                     String                             @unique
  passwordHash                        String
  emailVerifiedAt                     DateTime?
  bankWithdrawalHoldUntil             DateTime?
  phoneE164                           String?                            @unique
  phoneVerifiedAt                     DateTime?
  accountStatus                       AccountStatus                      @default(PENDING_REVIEW)
  createdAt                           DateTime                           @default(now())
  updatedAt                           DateTime                           @updatedAt
  lastLoginAt                         DateTime?
  profile                             UserProfile?
  sessions                            Session[]
  roleAssignments                     RoleAssignment[]
  statusHistory                       AccountStatusHistory[]
  auditEvents                         AuditEvent[]                       @relation("ActorAuditEvents")
  publicCollectorProfile              PublicCollectorProfile?
  watchlistItems                      WatchlistItem[]
  notifications                       Notification[]
  notificationPreferences             NotificationPreference[]
  submissions                         AssetSubmission[]                  @relation("SubmissionOwner")
  assignedReviews                     VerificationReview[]               @relation("ReviewReviewer")
  valuationEvidence                   ValuationEvidence[]                @relation("ValuationEvidenceCreator")
  valuationDecisions                  ValuationDecision[]                @relation("ValuationDecisionCreator")
  ownershipSupplyPoliciesProposed     OwnershipSupplyPolicy[]            @relation("OwnershipSupplyPolicyProposer")
  ownershipSupplyPoliciesApproved     OwnershipSupplyPolicy[]            @relation("OwnershipSupplyPolicyApprover")
  publications                        AssetPublication[]                 @relation("PublicationActor")
  ownershipAccounts                   OwnershipAccount[]                 @relation("OwnershipAccountUser")
  financialAccounts                   FinancialAccount[]                 @relation("FinancialAccountUser")
  portfolioLots                       PortfolioLot[]
  tradingOrders                       TradingOrder[]                     @relation("TradingOrderUser")
  tradingOrdersActed                  TradingOrder[]                     @relation("TradingOrderActor")
  followingCollectors                 CollectorFollow[]                  @relation("CollectorFollower")
  followedByCollectors                CollectorFollow[]                  @relation("CollectorFollowed")
  discussionPosts                     DiscussionPost[]                   @relation("DiscussionAuthor")
  contentReports                      ContentReport[]                    @relation("ContentReporter")
  moderationActions                   ModerationAction[]                 @relation("ModerationActor")
  saleProposals                       SaleProposal[]                     @relation("SaleProposer")
  proposalEligibility                 ProposalEligibility[]              @relation("EligibilityUser")
  proposalVotes                       ProposalVote[]                     @relation("VoteCaster")
  externalSaleVerifications           ExternalSaleVerification[]         @relation("SaleVerifier")
  saleVerificationApprovals           ExternalSaleVerificationApproval[] @relation("SaleVerificationApprover")
  complianceCases                     ComplianceCase[]
  complianceDecisions                 ComplianceDecision[]               @relation("ComplianceDecisionActor")
  externalFinancialAccounts           ExternalFinancialAccount[]
  bankSecurityEvents                  BankSecurityEvent[]
  externalProviderCustomers           ExternalProviderCustomer[]
  financialConnectionSessions         FinancialConnectionSession[]
  bacsSetupSessions                   BacsSetupSession[]
  externalConnectAccounts             ExternalConnectAccount[]
  moneyMovements                      MoneyMovement[]
  complianceHolds                     ComplianceHold[]
  financialDeficits                   FinancialDeficit[]
  providerIncidents                   ProviderIncident[]                 @relation("ProviderIncidentOwner")
  discordAccountLink                  DiscordAccountLink?
  discordOAuthStates                  DiscordOAuthState[]
  emailVerificationTokens             EmailVerificationToken[]
  passwordResetTokens                 PasswordResetToken[]
  transactionalEmailDeliveries        TransactionalEmailDelivery[]
  phoneVerificationChallenges         PhoneVerificationChallenge[]
  twoFactor                           UserTwoFactor?
  smsTwoFactor                        UserSmsTwoFactor?
  twoFactorRecoveryCodes              TwoFactorRecoveryCode[]
  twoFactorLoginChallenges            TwoFactorLoginChallenge[]
  sensitiveActionChallenges           TwoFactorActionChallenge[]
  deletionRequests                    AccountDeletionRequest[]
  consentAcceptances                  ConsentAcceptance[]
  collectorSubscriptions              CollectorSubscription[]
  receiptConfirmations                IntakeReceiptConfirmation[]        @relation("ReceiptConfirmer")
  portfolioSnapshots                  PortfolioSnapshot[]
  controlledBetaBypasses              ControlledBetaPhysicalBypass[]     @relation("ControlledBetaBypassActor")
  stagingDemoPhysicalIntakes          StagingDemoPhysicalIntake[]        @relation("StagingDemoPhysicalIntakeActor")
  initialOfferingsOriginated          InitialOffering[]                  @relation("InitialOfferingOriginator")
  initialOfferingsBeneficiary         InitialOffering[]                  @relation("InitialOfferingBeneficiary")
  initialOfferingInventories          InitialOfferingInventory[]         @relation("InitialOfferingInventoryBeneficiary")
  platformRevenueSettlementsRequested PlatformRevenueSettlement[]        @relation("PlatformRevenueSettlementRequester")
  platformRevenueSettlementsApproved  PlatformRevenueSettlement[]        @relation("PlatformRevenueSettlementApprover")
  adminOverrides                       AccountAdminOverride[]            @relation("AccountAdminOverrideTarget")
  authoredAdminOverrides               AccountAdminOverride[]            @relation("AccountAdminOverrideActor")

  @@index([accountStatus])
}

/// Append-only evidence of a customer's explicit signup or later policy
/// acceptance.  A new policy version creates a new row; old evidence is never
/// rewritten to imply acceptance of a newer policy.
model ConsentAcceptance {
  id            String      @id @default(cuid())
  userId        String
  consentType   ConsentType
  policyVersion String
  acceptedAt    DateTime
  source        String      @default("SIGNUP")
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType, policyVersion])
  @@index([userId, consentType, acceptedAt, id])
}

/// Customer-requested lifecycle only. Completion/anonymisation remains a
/// future privileged retention-policy operation; this model never deletes
/// accounting, trade, provider, compliance, or audit authority.
model AccountDeletionRequest {
  id            String                       @id @default(cuid())
  userId        String
  status        AccountDeletionRequestStatus @default(REQUESTED)
  reason        String?
  blockedReason String?
  requestedAt   DateTime                     @default(now())
  reviewedAt    DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  user          User                         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt, id])
  @@index([status, createdAt, id])
}

/// One-time email proof. The raw token is deliberately never persisted.
model EmailVerificationToken {
  id                String                           @id @default(cuid())
  userId            String
  tokenHash         String                           @unique
  expiresAt         DateTime
  deliveryStatus    TransactionalEmailDeliveryStatus @default(PENDING)
  deliveredAt       DateTime?
  deliveryFailedAt  DateTime?
  providerMessageId String?
  consumedAt        DateTime?
  createdAt         DateTime                         @default(now())
  user              User                             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, consumedAt, expiresAt])
}

/// One-time password reset proof. The raw token is never persisted.
model PasswordResetToken {
  id                String                           @id @default(cuid())
  userId            String
  tokenHash         String                           @unique
  deliveryStatus    TransactionalEmailDeliveryStatus @default(PENDING)
  deliveredAt       DateTime?
  deliveryFailedAt  DateTime?
  providerMessageId String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime                         @default(now())
  user              User                             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, consumedAt, expiresAt])
  @@index([userId, deliveryStatus, createdAt])
}

/// Operationally useful delivery state without duplicating raw recipient data.
model TransactionalEmailDelivery {
  id                String                           @id @default(cuid())
  userId            String?
  recipientHash     String
  emailType         String
  provider          String
  providerMessageId String?
  idempotencyKey    String                           @unique
  status            TransactionalEmailDeliveryStatus @default(PENDING)
  queuedAt          DateTime                         @default(now())
  sentAt            DateTime?
  failedAt          DateTime?
  failureCode       String?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  user              User?                            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, queuedAt])
}

/// One-time phone proof. OTP values are deliberately stored only as Argon2id
/// hashes; a newly verified number replaces the current number atomically.
model PhoneVerificationChallenge {
  id               String                          @id @default(cuid())
  userId           String
  phoneE164        String
  /// Legacy hashes are nullable and unused. New challenges never persist OTPs.
  codeHash         String?
  deliveryStatus   PhoneVerificationDeliveryStatus @default(PENDING)
  deliveredAt      DateTime?
  deliveryFailedAt DateTime?
  expiresAt        DateTime
  consumedAt       DateTime?
  supersededAt     DateTime?
  attemptCount     Int                             @default(0)
  createdAt        DateTime                        @default(now())
  user             User                            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phoneE164, createdAt])
  @@index([userId, consumedAt, supersededAt, expiresAt])
  @@index([userId, deliveryStatus, createdAt])
}

/// Slice-owned TOTP authority. The secret is AES-GCM encrypted and is only
/// decryptable by the backend while validating a supplied one-time password.
model UserTwoFactor {
  userId              String    @id
  secretCiphertext    String
  enabledAt           DateTime?
  enrollmentStartedAt DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabledAt])
}

/// Slice-owned SMS MFA method. Twilio Verify owns the OTP; this row owns only
/// the explicit enrollment and enabled state bound to a verified phone.
model UserSmsTwoFactor {
  userId              String    @id
  phoneE164           String
  enabledAt           DateTime?
  enrollmentStartedAt DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabledAt])
}

/// One-way digests only. Plaintext recovery codes are returned once during
/// enrollment/regeneration and are never available for later retrieval.
model TwoFactorRecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String    @unique
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

/// A password-success challenge is not a session. Its opaque proof is stored
/// only as a digest and is consumed before a normal session is issued.
model TwoFactorLoginChallenge {
  id           String          @id @default(cuid())
  userId       String
  tokenHash    String          @unique
  method       TwoFactorMethod @default(TOTP)
  phoneE164    String?
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int             @default(0)
  lastSentAt   DateTime?
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

/// Short-lived MFA proofs for sensitive actions. This is deliberately separate
/// from login challenges so an account-unlink proof can never be exchanged for
/// a session.
model TwoFactorActionChallenge {
  id           String          @id @default(cuid())
  userId       String
  tokenHash    String          @unique
  action       String
  method       TwoFactorMethod
  phoneE164    String?
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int             @default(0)
  lastSentAt   DateTime?
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, consumedAt, expiresAt])
}

/// Minimal Slice-owned Discord identity link. OAuth tokens are intentionally not retained.
model DiscordAccountLink {
  id            String   @id @default(cuid())
  userId        String   @unique
  discordUserId String   @unique
  username      String
  displayName   String?
  linkedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discordUserId])
}

/// Short-lived, single-use OAuth state. The raw state value never reaches persistence.
model DiscordOAuthState {
  id         String    @id @default(cuid())
  userId     String
  stateHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Bot-issued handoff for a Slice-authenticated user to claim their Discord identity.
/// The raw challenge is returned once to Discord and is never persisted.
model DiscordBotLinkChallenge {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique
  discordUserId      String
  discordUsername    String
  discordDisplayName String?
  guildId            String?
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([discordUserId, expiresAt])
  @@index([expiresAt])
}

model UserProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  displayName       String
  publicUsername    String?   @unique
  usernameChangedAt DateTime?
  avatarReference   String?
  countryCode       String    @default("GB")
  preferredCurrency String    @default("GBP")
  timezone          String    @default("Europe/London")
  locale            String    @default("en-GB")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id                  String    @id @default(cuid())
  publicId            String    @unique
  userId              String
  tokenHash           String
  familyId            String
  replacedBySessionId String?
  issuedAt            DateTime  @default(now())
  authenticatedAt     DateTime  @default(now())
  /// Password confirmation freshness for sensitive account actions, bound to
  /// this exact session and separate from the original login timestamp.
  recentAuthAt        DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  revocationReason    String?
  lastActivityAt      DateTime  @default(now())
  userAgent           String?
  ipHash              String?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId, revokedAt])
  @@index([userId, publicId])
  @@index([familyId])
  @@index([recentAuthAt])
}

model AccountStatusHistory {
  id          String         @id @default(cuid())
  userId      String
  fromStatus  AccountStatus?
  toStatus    AccountStatus
  reason      String
  actorUserId String?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RoleAssignment {
  id               String    @id @default(cuid())
  userId           String
  role             Role
  scopeType        String    @default("GLOBAL")
  scopeId          String    @default("*")
  assignedByUserId String?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, scopeType, scopeId, revokedAt])
}

model AuditEvent {
  id           String         @id @default(cuid())
  actorUserId  String?
  actorType    AuditActorType
  action       String
  resourceType String
  resourceId   String?
  requestId    String?
  sessionId    String?
  result       AuditResult
  metadata     Json?
  createdAt    DateTime       @default(now())
  actor        User?          @relation("ActorAuditEvents", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([actorUserId, createdAt])
}

/// Immutable, explicit account-level overrides. These records never replace
/// provider truth or ledger authority; they document a Slice-owned exception.
model AccountAdminOverride {
  id                 String   @id @default(cuid())
  userId             String
  actorUserId        String
  command            String
  targetType         String
  targetKey          String?
  forcedState        String?
  normalBlocker      String?
  reason             String
  beforeState        Json
  afterState         Json
  affectedCapabilities String[]
  source             String
  incidentReference  String?
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  user               User     @relation("AccountAdminOverrideTarget", fields: [userId], references: [id], onDelete: Restrict)
  actor              User     @relation("AccountAdminOverrideActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([userId, targetType, targetKey, expiresAt])
  @@index([actorUserId, createdAt])
}

model IdempotencyRecord {
  id             String            @id @default(cuid())
  key            String
  scope          String            @default("default")
  actorScope     String            @default("system")
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  @@unique([actorScope, scope, key])
  @@index([expiresAt])
}

model Category {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  iconKey     String?
  description String?
  status      CatalogueStatus   @default(ACTIVE)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sets        CollectibleSet[]
  assets      Asset[]
  submissions AssetSubmission[]

  @@index([status, sortOrder, id])
}

model CollectibleSet {
  id           String            @id @default(cuid())
  categoryId   String
  slug         String            @unique
  name         String
  manufacturer String?
  releaseYear  Int?
  edition      String?
  status       CatalogueStatus   @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assets       Asset[]
  submissions  AssetSubmission[]

  @@index([categoryId, status, id])
}

model GradingCompany {
  id                            String            @id @default(cuid())
  code                          String            @unique
  name                          String
  displayName                   String            @default("")
  verificationMode              String            @default("MANUAL_OFFICIAL_LOOKUP")
  supportsCertVerification      Boolean           @default(true)
  supportsAutomatedVerification Boolean           @default(false)
  officialVerificationUrl       String?
  certificationFormat           String?
  gradeScaleVersion             String            @default("unconfirmed-v1")
  status                        CatalogueStatus   @default(ACTIVE)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  grades                        GradeScaleEntry[]

  @@index([status, code])
}

model GradeScaleEntry {
  id             String            @id @default(cuid())
  companyId      String
  grade          Decimal           @db.Decimal(4, 2)
  label          String
  conditionLabel String?
  designation    String            @default("")
  legacy         Boolean           @default(false)
  gradeEra       String?
  scaleVersion   String?
  sortOrder      Int               @default(0)
  active         Boolean           @default(true)
  company        GradingCompany    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assets         Asset[]
  submissions    AssetSubmission[]

  @@unique([companyId, grade, designation])
  @@index([companyId, active, sortOrder, id])
}

model Asset {
  id                            String                        @id @default(cuid())
  publicId                      String                        @unique
  slug                          String                        @unique
  categoryId                    String
  setId                         String?
  title                         String
  shortName                     String?
  year                          Int?
  manufacturer                  String?
  edition                       String?
  cardNumber                    String?
  description                   String?
  gradeScaleEntryId             String?
  certificationNumber           String?
  normalizedCertificationNumber String?
  status                        AssetCatalogueStatus          @default(DRAFT)
  heroMediaId                   String?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  publishedAt                   DateTime?
  category                      Category                      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collectibleSet                CollectibleSet?               @relation(fields: [setId], references: [id], onDelete: Restrict)
  gradeScaleEntry               GradeScaleEntry?              @relation(fields: [gradeScaleEntryId], references: [id], onDelete: Restrict)
  valuationPoints               AssetValuationPoint[]
  marketSnapshots               AssetMarketSnapshot[]
  marketProviderMappings        MarketProviderMapping[]
  marketObservations            MarketObservation[]
  marketRefreshJobs             MarketRefreshJob[]
  watchlistItems                WatchlistItem[]
  vaultPublicEvents             VaultPublicEvent[]
  submissions                   AssetSubmission[]
  valuationEvidence             ValuationEvidence[]
  valuationDecisions            ValuationDecision[]
  custodyRecord                 VaultCustodyRecord?
  custodyEvents                 CustodyEvent[]
  insuranceCoverage             InsuranceCoverage[]
  publication                   AssetPublication?
  ownershipSupply               OwnershipAssetSupply?
  ownershipSupplyPolicy         OwnershipSupplyPolicy?
  portfolioLots                 PortfolioLot[]
  tradingMarket                 TradingMarket?
  tradingOrders                 TradingOrder[]
  tradingExecutions             TradingExecution[]
  discussionPosts               DiscussionPost[]
  saleProposals                 SaleProposal[]
  controlledBetaBypass          ControlledBetaPhysicalBypass?
  stagingDemoPhysicalIntake     StagingDemoPhysicalIntake?
  initialOffering               InitialOffering?
  initialOfferingInventory      InitialOfferingInventory[]
  certificationClaims           GradingCertificationClaim[]
  operationalControl            AssetOperationalControl?

  @@unique([gradeScaleEntryId, certificationNumber])
  @@index([status, categoryId, id])
  @@index([setId, status, id])
  @@index([title, id])
}

/// Administrative progression gate. This record never rewrites ownership,
/// offering, trade, custody, or publication history; it only prevents new
/// operational progression until an authorised operator removes the freeze.
model AssetOperationalControl {
  assetId         String                        @id
  status          AssetOperationalControlStatus @default(ACTIVE)
  reason          String
  version         Int                           @default(1)
  frozenAt        DateTime?
  unfrozenAt      DateTime?
  updatedByUserId String
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  asset           Asset                         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt, assetId])
}

model PublicCollectorProfile {
  userId      String    @id
  slug        String    @unique
  headline    String?
  specialism  String?
  isPublic    Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  featuredAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPublic, slug])
  @@index([isPublic, createdAt, userId])
  @@index([isPublic, isFeatured, featuredAt, createdAt, userId])
}

model WatchlistItem {
  userId    String
  assetId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([userId, assetId])
  @@index([userId, createdAt])
}

model Notification {
  id           String    @id @default(cuid())
  deliveryId   String?   @unique
  userId       String
  type         String
  title        String
  body         String
  resourceType String?
  resourceId   String?
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt, id])
}

/// Product notification policy. This is intentionally unrelated to Discord role UX.
model NotificationPreference {
  id        String                      @id @default(cuid())
  userId    String
  topic     String
  channel   NotificationDeliveryChannel
  enabled   Boolean                     @default(true)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic, channel])
  @@index([userId, topic])
}

model AssetSubmission {
  id                            String                             @id @default(cuid())
  ownerUserId                   String
  assetId                       String?
  status                        SubmissionStatus                   @default(DRAFT)
  version                       Int                                @default(1)
  currentStep                   Int                                @default(1)
  categoryId                    String
  setId                         String?
  gradeScaleEntryId             String?
  declaredMetadata              Json?
  /// Staff-reviewed identity. Collector-supplied declaredMetadata is never
  /// overwritten during review; this overlay becomes the explicit authority
  /// used by canonicalization only after a reviewed decision.
  reviewMetadata                Json?
  normalizedCertificationNumber String?
  preferredIntakeLocationId     String?
  preferredDeliveryMethod       IntakeDeliveryMethod?
  submittedAt                   DateTime?
  reviewedAt                    DateTime?
  reviewerId                    String?
  decisionCode                  String?
  decisionNote                  String?
  cancelledAt                   DateTime?
  createdAt                     DateTime                           @default(now())
  updatedAt                     DateTime                           @updatedAt
  owner                         User                               @relation("SubmissionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  asset                         Asset?                             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  category                      Category                           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collectibleSet                CollectibleSet?                    @relation(fields: [setId], references: [id], onDelete: Restrict)
  gradeScaleEntry               GradeScaleEntry?                   @relation(fields: [gradeScaleEntryId], references: [id], onDelete: Restrict)
  media                         SubmissionMedia[]
  reviews                       VerificationReview[]
  marketResearch                SubmissionMarketResearch[]
  intake                        SubmissionIntake?
  preferredIntakeLocation       VaultIntakeLocation?               @relation("SubmissionPreferredIntakeLocation", fields: [preferredIntakeLocationId], references: [id], onDelete: SetNull)
  preGrades                     RawCardPreGrade[]
  controlledBetaBypass          ControlledBetaPhysicalBypass?
  stagingDemoPhysicalIntake     StagingDemoPhysicalIntake?
  certificationVerifications    GradingCertificationVerification[]
  certificationClaims           GradingCertificationClaim[]
  reviewFindings                SubmissionReviewFinding[]

  @@index([ownerUserId, status, createdAt, id])
  @@index([status, submittedAt, id])
  @@index([reviewerId, status, updatedAt, id])
  @@index([preferredIntakeLocationId])
}

enum SubmissionReviewFindingSeverity {
  ADVISORY
  BLOCKING
}

enum SubmissionReviewFindingStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A staff-authored review finding. Findings are deliberately separate from
/// evidence-upload safety and decision notes so readiness can expose only
/// unresolved blocking findings without losing the complete audit trail.
model SubmissionReviewFinding {
  id                String                          @id @default(cuid())
  submissionId      String
  section           String
  title             String
  detail            String?
  severity          SubmissionReviewFindingSeverity @default(ADVISORY)
  status            SubmissionReviewFindingStatus   @default(OPEN)
  customerAction    Boolean                         @default(false)
  createdByUserId   String
  resolvedByUserId  String?
  resolutionNote    String?
  resolvedAt        DateTime?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  submission        AssetSubmission                 @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([submissionId, status, severity, createdAt, id])
  @@index([createdByUserId, createdAt, id])
}

/// A provider-backed or staff-confirmed certification lookup. Provider data is
/// evidence only until a staff member confirms the identity and scale entry.
/// Current companies deliberately use the official manual lookup mode; the
/// schema is ready for an approved machine provider without pretending one is
/// configured.
model GradingCertificationVerification {
  id                            String          @id @default(cuid())
  submissionId                  String
  requestedByUserId             String
  companyCode                   String
  certificationNumber           String
  normalizedCertificationNumber String
  status                        String
  verificationMode              String
  officialVerificationUrl       String?
  providerReference             String?
  verifiedCard                  Json?
  verifiedGrade                 String?
  verifiedLabel                 String?
  designation                   String?
  subgrades                     Json?
  gradeEra                      String?
  verifiedAt                    DateTime?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  submission                    AssetSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt, id])
  @@index([companyCode, normalizedCertificationNumber, status])
}

/// One durable claim per company/certification number. Rejected or cancelled
/// submissions release the claim by moving it to RELEASED, while history is
/// retained in the verification and audit records.
model GradingCertificationClaim {
  id                            String           @id @default(cuid())
  companyCode                   String
  normalizedCertificationNumber String
  submissionId                  String?
  assetId                       String?
  status                        String           @default("SUBMISSION")
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
  submission                    AssetSubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  asset                         Asset?           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([companyCode, normalizedCertificationNumber])
  @@index([submissionId, status])
  @@index([assetId, status])
}

/// Provider-backed AI evidence for a raw card. This is supporting evidence
/// only: it never changes the submission's grade, valuation, or readiness.
model RawCardPreGrade {
  id                  String                @id @default(cuid())
  submissionId        String
  requestedByUserId   String
  provider            String
  providerRequestId   String?
  status              RawCardPreGradeStatus @default(IN_PROGRESS)
  overallEstimate     Float?
  overallMin          Float?
  overallMax          Float?
  frontDetected       Boolean?
  backDetected        Boolean?
  centeringScore      Float?
  cornerScore         Float?
  edgeScore           Float?
  surfaceScore        Float?
  confidence          Float?
  conditionLabel      String?
  autographDetected   Boolean?
  categoryDetected    String?
  warnings            Json?
  analysisFingerprint String
  analyzedAt          DateTime?
  providerVersion     String?
  errorCode           String?
  rawResponse         Json?
  visualizations      Json?
  supersededAt        DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  submission          AssetSubmission       @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([submissionId, analysisFingerprint])
  @@index([submissionId, createdAt])
  @@index([status, updatedAt])
}

/// External collectible-market reference data captured for a D10 submission.
/// It is supporting research only: D11 valuation and publication remain separate
/// staff-controlled lifecycle decisions.
model SubmissionMarketResearch {
  id               String                        @id @default(cuid())
  submissionId     String?
  ownerUserId      String
  identityHash     String
  identity         Json
  state            String
  dataQuality      String?
  sourceCoverage   Json
  providerFailures Json
  snapshot         Json
  collectedAt      DateTime
  expiresAt        DateTime
  createdAt        DateTime                      @default(now())
  submission       AssetSubmission?              @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  observations     SubmissionMarketObservation[]

  @@index([ownerUserId, identityHash, expiresAt])
  @@index([submissionId, collectedAt, id])
}

/// Normalized whole-card market observation. Original currency and source
/// provenance are retained; this model never represents Slice share trading.
model SubmissionMarketObservation {
  id                  String                   @id @default(cuid())
  researchId          String
  providerCode        String
  externalReferenceId String
  externalUrl         String?
  observationType     String
  originalTitle       String
  amountMinor         BigInt
  currency            String
  observedAt          DateTime
  soldAt              DateTime?
  grader              String?
  grade               String?
  variant             String?
  matchQuality        String
  exclusionReason     String?
  includedInSnapshot  Boolean                  @default(false)
  ingestedAt          DateTime                 @default(now())
  research            SubmissionMarketResearch @relation(fields: [researchId], references: [id], onDelete: Restrict)

  @@unique([researchId, providerCode, externalReferenceId])
  @@index([researchId, observationType, matchQuality, observedAt])
}

model SubmissionMedia {
  id                String                @id @default(cuid())
  submissionId      String
  slot              String
  objectKey         String                @unique
  originalFilename  String
  mimeType          String
  sizeBytes         Int
  sha256            String?
  status            SubmissionMediaStatus @default(PENDING_UPLOAD)
  scanResultCode    String?
  deletedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  submission        AssetSubmission       @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  valuationEvidence ValuationEvidence[]   @relation("ValuationEvidenceDocument")
  coverageEvidence  InsuranceCoverage[]   @relation("InsuranceCoverageDocument")

  @@index([submissionId, status, slot])
  @@index([sha256])
}

model ValuationEvidence {
  id              String           @id @default(cuid())
  assetId         String
  sourceType      String
  sourceRef       String?
  observedAt      DateTime
  valueMinor      BigInt
  currency        String
  conditionBasis  String
  confidence      Int
  documentMediaId String?
  createdByUserId String
  supersedesId    String?
  createdAt       DateTime         @default(now())
  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  documentMedia   SubmissionMedia? @relation("ValuationEvidenceDocument", fields: [documentMediaId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("ValuationEvidenceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([assetId, observedAt, id])
  @@index([assetId, sourceType, createdAt])
}

model ValuationDecision {
  id               String                  @id @default(cuid())
  assetId          String
  valueMinor       BigInt
  currency         String
  confidence       Int
  methodologyCode  String
  decidedByUserId  String
  decidedAt        DateTime
  status           ValuationDecisionStatus @default(ACTIVE)
  createdAt        DateTime                @default(now())
  asset            Asset                   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  decidedBy        User                    @relation("ValuationDecisionCreator", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  initialOfferings InitialOffering[]

  @@index([assetId, status, decidedAt, id])
}

model VaultCustodyRecord {
  id           String         @id @default(cuid())
  assetId      String         @unique
  providerCode String
  facilityCode String?
  status       CustodyStatus  @default(EXPECTED)
  providerRef  String?
  receivedAt   DateTime?
  securedAt    DateTime?
  updatedAt    DateTime       @updatedAt
  asset        Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  events       CustodyEvent[]

  @@index([status, updatedAt, id])
}

/// Per-asset issuance authority. Approval configures supply only; it never
/// creates ownership, market, payment, or settlement state.
model OwnershipSupplyPolicy {
  id                String                      @id @default(cuid())
  assetId           String                      @unique
  policyCode        String
  status            OwnershipSupplyPolicyStatus @default(PROPOSED)
  proposedUnits     BigInt
  valuationMinor    BigInt
  valuationCurrency String
  pricePerUnitMinor BigInt
  remainderMinor    BigInt
  reason            String
  proposedByUserId  String
  approvedByUserId  String?
  proposedAt        DateTime                    @default(now())
  approvedAt        DateTime?
  issuedAt          DateTime?
  updatedAt         DateTime                    @updatedAt
  asset             Asset                       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  proposedBy        User                        @relation("OwnershipSupplyPolicyProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?                       @relation("OwnershipSupplyPolicyApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  initialOffering   InitialOffering?

  @@index([status, updatedAt, assetId])
}

model CustodyEvent {
  id              String             @id @default(cuid())
  assetId         String
  custodyRecordId String
  fromStatus      CustodyStatus?
  toStatus        CustodyStatus
  actorUserId     String?
  providerRef     String?
  occurredAt      DateTime
  createdAt       DateTime           @default(now())
  asset           Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  custodyRecord   VaultCustodyRecord @relation(fields: [custodyRecordId], references: [id], onDelete: Restrict)

  @@index([assetId, occurredAt, id])
  @@index([custodyRecordId, createdAt, id])
}

model InsuranceCoverage {
  id                String                  @id @default(cuid())
  assetId           String
  providerCode      String
  policyRef         String?
  insuredValueMinor BigInt
  currency          String
  status            InsuranceCoverageStatus @default(PENDING)
  effectiveAt       DateTime
  expiresAt         DateTime
  evidenceMediaId   String?
  updatedAt         DateTime                @updatedAt
  asset             Asset                   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  evidenceMedia     SubmissionMedia?        @relation("InsuranceCoverageDocument", fields: [evidenceMediaId], references: [id], onDelete: Restrict)

  @@index([assetId, status, expiresAt, id])
}

model AssetPublication {
  id                String                 @id @default(cuid())
  assetId           String                 @unique
  status            AssetPublicationStatus @default(BLOCKED)
  readiness         Json
  publishedAt       DateTime?
  publishedByUserId String?
  unpublishedAt     DateTime?
  version           Int                    @default(1)
  updatedAt         DateTime               @updatedAt
  asset             Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  publishedBy       User?                  @relation("PublicationActor", fields: [publishedByUserId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt, id])
}

/// Explicit, audited staging-only continuation for a named Beta QA asset.
/// This does not change shipment, delivery, receipt, or custody state.
model ControlledBetaPhysicalBypass {
  id              String          @id @default(cuid())
  submissionId    String          @unique
  assetId         String          @unique
  reasonCode      String
  reason          String
  createdByUserId String
  createdAt       DateTime        @default(now())
  submission      AssetSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("ControlledBetaBypassActor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([assetId, createdAt, id])
  @@index([createdByUserId, createdAt, id])
}

/// Explicit staging-only simulated physical authority. This is never a
/// production shipment, Slice receipt, verification, or vault-custody record.
model StagingDemoPhysicalIntake {
  id                 String          @id @default(cuid())
  submissionId       String          @unique
  assetId            String          @unique
  fixtureKey         String
  status             String          @default("DEMO_INTAKE")
  destinationLabel   String
  simulationNote     String
  identityMatch      Boolean
  certificationMatch Boolean
  gradeMatch         Boolean
  variantMatch       Boolean
  simulatedReceiptAt DateTime
  verifiedAt         DateTime
  custodyAt          DateTime
  completedByUserId  String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  submission         AssetSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  asset              Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  completedBy        User            @relation("StagingDemoPhysicalIntakeActor", fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@index([completedByUserId, createdAt, id])
}

model VerificationReview {
  id                  String                   @id @default(cuid())
  submissionId        String
  reviewerId          String
  status              VerificationReviewStatus @default(CLAIMED)
  decision            String?
  reasonCode          String?
  note                String?
  staffCondition      String?
  staffConditionNote  String?
  valuationMinor      BigInt?
  valuationCurrency   String?
  valuationBasis      String?
  valuationConfidence Int?
  valuationNote       String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  completedAt         DateTime?
  submission          AssetSubmission          @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer            User                     @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt, id])
  @@index([reviewerId, status, createdAt, id])
}

model VaultPublicEvent {
  id            String   @id @default(cuid())
  assetId       String
  type          String
  occurredAt    DateTime
  publicSummary String
  status        String   @default("PUBLISHED")
  sourceRef     String?
  createdAt     DateTime @default(now())
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([status, occurredAt, id])
  @@index([assetId, occurredAt])
}

/// Central, backend-owned collector plan configuration. Entitlements are read
/// by the API and are never duplicated as numeric constants in the client.
model CollectorPlan {
  id                String                  @id @default(cuid())
  code              CollectorPlanCode       @unique
  displayName       String
  description       String                  @default("")
  monthlyPriceMinor BigInt
  currency          String                  @default("GBP")
  billingInterval   String                  @default("month")
  sortOrder         Int                     @default(0)
  entitlements      Json
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  subscriptions     CollectorSubscription[]
}

model CollectorSubscription {
  id                         String                               @id @default(cuid())
  userId                     String
  planId                     String
  status                     CollectorSubscriptionStatus          @default(INCOMPLETE)
  provider                   String?
  providerCustomerId         String?
  providerSubscriptionId     String?                              @unique
  providerCheckoutSessionId  String?                              @unique
  providerPriceId            String?
  currentPeriodStart         DateTime?
  currentPeriodEnd           DateTime?
  cancelAtPeriodEnd          Boolean                              @default(false)
  paymentMethodBrand         String?
  paymentMethodLast4         String?
  paymentMethodExpMonth      Int?
  paymentMethodExpYear       Int?
  lastProviderEventCreatedAt DateTime?
  lastProviderEventIdHash    String?
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt
  user                       User                                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan                       CollectorPlan                        @relation(fields: [planId], references: [id], onDelete: Restrict)
  statusHistory              CollectorSubscriptionStatusHistory[]

  @@index([userId, status, updatedAt])
  @@index([provider, providerCustomerId])
  @@index([lastProviderEventCreatedAt])
}

model CollectorSubscriptionStatusHistory {
  id                  String                       @id @default(cuid())
  subscriptionId      String
  fromStatus          CollectorSubscriptionStatus?
  toStatus            CollectorSubscriptionStatus
  source              String
  providerEventIdHash String?
  reason              String?
  createdAt           DateTime                     @default(now())
  subscription        CollectorSubscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt, id])
  @@index([providerEventIdHash])
}

/// Customer-safe intake destinations. Facility/security metadata is kept out
/// of this projection and remains staff-controlled.
model VaultIntakeLocation {
  id                     String               @id @default(cuid())
  displayName            String
  region                 String
  countryCode            String
  active                 Boolean              @default(true)
  intakeAvailable        Boolean              @default(true)
  operationallyApproved  Boolean              @default(false)
  environment            String               @default("beta")
  acceptingShipments     Boolean              @default(false)
  acceptingInPerson      Boolean              @default(false)
  locationType           IntakeLocationType   @default(SLICE_VAULT)
  status                 IntakeLocationStatus @default(ACTIVE)
  receiverName           String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  postalCode             String?
  acceptedCategories     Json?
  shippingInstructions   String
  inPersonInstructions   String?
  customerSafeAddress    String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  intakes                SubmissionIntake[]
  preferredBySubmissions AssetSubmission[]    @relation("SubmissionPreferredIntakeLocation")

  @@unique([displayName, countryCode])
  @@index([active, intakeAvailable, countryCode, id])
  @@index([status, environment, countryCode, id])
}

model SubmissionIntake {
  id                  String                     @id @default(cuid())
  submissionId        String                     @unique
  vaultId             String
  deliveryMethod      IntakeDeliveryMethod       @default(SHIPMENT)
  status              IntakeStatus               @default(VAULT_SELECTED)
  intakeReference     String                     @unique
  selectedAt          DateTime                   @default(now())
  shippedAt           DateTime?
  deliveredAt         DateTime?
  receivedAt          DateTime?
  destinationSnapshot Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  submission          AssetSubmission            @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  vault               VaultIntakeLocation        @relation(fields: [vaultId], references: [id], onDelete: Restrict)
  shipment            IntakeShipment?
  receipt             IntakeReceiptConfirmation?
  verification        IntakeVerification?
  exceptions          IntakeException[]

  @@index([vaultId, status, updatedAt, id])
}

model IntakeShipment {
  id             String               @id @default(cuid())
  intakeId       String               @unique
  carrier        String
  trackingNumber String
  shippedAt      DateTime
  status         IntakeShipmentStatus @default(SHIPPED)
  deliveredAt    DateTime?
  lastCheckedAt  DateTime?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  intake         SubmissionIntake     @relation(fields: [intakeId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt, id])
}

model IntakeReceiptConfirmation {
  id               String           @id @default(cuid())
  intakeId         String           @unique
  confirmedAt      DateTime         @default(now())
  confirmedById    String
  shipmentRef      String?
  auditReference   String?
  intake           SubmissionIntake @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  confirmedBy      User             @relation("ReceiptConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  packageCondition String?
  checklist        Json?
  notes            String?
  photoMediaIds    Json?

  @@index([confirmedById, confirmedAt, id])
}

/// Slice-owned verification authority for the physical intake handoff. This
/// is deliberately separate from shipment delivery and from financial review.
model IntakeVerification {
  id                       String                   @id @default(cuid())
  intakeId                 String                   @unique
  status                   IntakeVerificationStatus @default(NOT_STARTED)
  identityMatch            Boolean?
  certificationMatch       Boolean?
  gradeMatch               Boolean?
  variantMatch             Boolean?
  note                     String?
  startedById              String?
  completedById            String?
  startedAt                DateTime?
  completedAt              DateTime?
  completionIdempotencyKey String?                  @unique
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  intake                   SubmissionIntake         @relation(fields: [intakeId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt, id])
}

/// Explicit intake exception authority. An active exception blocks receipt
/// verification and downstream custody progress until a staff member resolves it.
model IntakeException {
  id             String                  @id @default(cuid())
  intakeId       String
  code           IntakeExceptionCode
  severity       IntakeExceptionSeverity @default(MEDIUM)
  notes          String
  idempotencyKey String?
  createdById    String
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime                @default(now())
  resolvedAt     DateTime?
  updatedAt      DateTime                @updatedAt
  intake         SubmissionIntake        @relation(fields: [intakeId], references: [id], onDelete: Restrict)

  @@index([intakeId, resolvedAt, createdAt, id])
  @@index([code, resolvedAt, createdAt, id])
}

model MarketSnapshot {
  id                             String           @id @default(cuid())
  asOf                           DateTime
  currency                       String
  totalEstimatedMarketValueMinor BigInt
  volume24hMinor                 BigInt
  activeAssetCount               Int
  collectorCount                 Int
  source                         String
  status                         MarketDataStatus
  createdAt                      DateTime         @default(now())

  @@unique([source, asOf])
  @@index([asOf, id])
}

model AssetValuationPoint {
  id                        String           @id @default(cuid())
  assetId                   String
  observedAt                DateTime
  estimatedMarketValueMinor BigInt
  currency                  String
  source                    String
  status                    MarketDataStatus
  createdAt                 DateTime         @default(now())
  asset                     Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([assetId, source, observedAt])
  @@index([assetId, observedAt, id])
}

model AssetMarketSnapshot {
  id                        String           @id @default(cuid())
  assetId                   String
  asOf                      DateTime
  estimatedMarketValueMinor BigInt
  currency                  String
  change24hBps              Int
  availableBps              Int?
  ownersCount               Int?
  watchersCount             Int?
  confidence                Int?
  source                    String
  status                    MarketDataStatus
  markSource                String           @default("SUPPORTED_VALUATION")
  freshness                 String           @default("UNAVAILABLE")
  lastSuccessfulRefreshAt   DateTime?
  createdAt                 DateTime         @default(now())
  asset                     Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([assetId, source, asOf])
  @@index([assetId, asOf, id])
  @@index([asOf, change24hBps, id])
}

/// Provider identity authority. Mappings are reused by scheduled refreshes;
/// provider-specific IDs are never rediscovered on a page render.
model MarketProviderMapping {
  id                        String              @id @default(cuid())
  assetId                   String
  providerCode              String
  providerExternalId        String
  providerUrl               String?
  identityHash              String
  status                    String              @default("AUTO_MATCHED")
  matchQuality              String              @default("STRONG")
  lastVerifiedAt            DateTime?
  lastSuccessAt             DateTime?
  lastFailureAt             DateTime?
  lastFailureCode           String?
  cooldownUntil             DateTime?
  nextRefreshAt             DateTime?
  currentPriceMinor         BigInt?
  currentCurrency           String?
  currentObservedAt         DateTime?
  referenceHistoryStartedAt DateTime?
  referenceMovement24hBps   Int?
  referenceMovement7dBps    Int?
  referenceMovement30dBps   Int?
  referenceMovement90dBps   Int?
  referenceMovement1yBps    Int?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  asset                     Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  observations              MarketObservation[]
  refreshJobs               MarketRefreshJob[]

  @@unique([assetId, providerCode])
  @@unique([providerCode, providerExternalId])
  @@index([status, nextRefreshAt, assetId])
  @@index([providerCode, status, lastSuccessAt])
}

/// Normalized whole-collectible observation history. Completed sales, active
/// listings, guides, and other approved references remain separate types.
model MarketObservation {
  id                 String                 @id @default(cuid())
  assetId            String
  mappingId          String?
  providerCode       String
  providerExternalId String
  observationType    String
  priceMinor         BigInt
  currency           String
  grader             String?
  grade              String?
  title              String
  externalUrl        String?
  occurredAt         DateTime?
  observedAt         DateTime
  matchQuality       String
  included           Boolean                @default(true)
  exclusionReason    String?
  sourceFingerprint  String
  provenance         Json?
  createdAt          DateTime               @default(now())
  asset              Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  mapping            MarketProviderMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)

  @@unique([providerCode, sourceFingerprint])
  @@index([assetId, observationType, matchQuality, observedAt])
  @@index([providerCode, providerExternalId, observedAt])
}

/// Durable refresh work with leases and idempotency protection.
model MarketRefreshJob {
  id             String                 @id @default(cuid())
  assetId        String
  mappingId      String?
  providerCode   String
  status         String                 @default("QUEUED")
  idempotencyKey String                 @unique
  attempts       Int                    @default(0)
  availableAt    DateTime               @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  leaseExpiresAt DateTime?
  lastErrorCode  String?
  lastErrorAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  asset          Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  mapping        MarketProviderMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)

  @@index([status, availableAt, createdAt, id])
  @@index([assetId, providerCode, status, availableAt])
}

/// Server-owned portfolio mark snapshots. Historical points are only recorded
/// from ledger, holdings, and persisted market marks.
model PortfolioSnapshot {
  id                        String   @id @default(cuid())
  userId                    String
  bucketStart               DateTime
  cashValueMinor            BigInt
  reservedValueMinor        BigInt
  holdingsMarketValueMinor  BigInt
  portfolioMarketValueMinor BigInt
  costBasisMinor            BigInt
  unrealizedPnlMinor        BigInt
  realizedPnlMinor          BigInt
  currency                  String
  marketDataFreshness       String
  source                    String
  createdAt                 DateTime @default(now())
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucketStart])
  @@index([userId, bucketStart, id])
}

/// Per-asset cap-table authority. Document 012 issues fixed, indivisible units;
/// this is intentionally separate from all future financial ledgers.
model OwnershipAssetSupply {
  assetId       String                 @id
  totalUnits    BigInt
  issuedUnits   BigInt                 @default(0)
  nextSequence  BigInt                 @default(1)
  status        OwnershipSupplyStatus  @default(PENDING)
  issuedAt      DateTime?
  version       Int                    @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  asset         Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  positions     OwnershipPosition[]
  ledgerEntries OwnershipLedgerEntry[]

  @@index([status, updatedAt, assetId])
}

/// A ledger principal. Initial issuance creates a private system treasury only;
/// no user allocation or public investor identity is created by this surface.
model OwnershipAccount {
  id                       String                    @id @default(cuid())
  type                     OwnershipAccountType
  userId                   String?                   @unique
  status                   OwnershipAccountStatus    @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  user                     User?                     @relation("OwnershipAccountUser", fields: [userId], references: [id], onDelete: Restrict)
  positions                OwnershipPosition[]
  debits                   OwnershipLedgerEntry[]    @relation("OwnershipLedgerDebit")
  credits                  OwnershipLedgerEntry[]    @relation("OwnershipLedgerCredit")
  proposalEligibilities    ProposalEligibility[]
  initialOfferingInventory InitialOfferingInventory?

  @@index([type, status, id])
}

/// Collector-originated inventory is explicit and never silently represented
/// as Slice Treasury. The ownership position remains the unit-level authority;
/// this record provides the offering identity and an auditable inventory view.
model InitialOffering {
  id                         String                    @id @default(cuid())
  assetId                    String                    @unique
  originatingCollectorUserId String
  beneficiaryUserId          String
  ownershipSupplyPolicyId    String                    @unique
  valuationDecisionId        String
  currency                   String
  totalUnits                 BigInt
  offeredUnits               BigInt
  retainedUnits              BigInt
  pricePerUnitMinor          BigInt
  grossOfferingMinor         BigInt
  feeScheduleVersion         String
  feeBps                     Int                       @default(0)
  status                     InitialOfferingStatus     @default(AWAITING_APPROVAL)
  approvedAt                 DateTime?
  openedAt                   DateTime?
  issuedAt                   DateTime?
  closedAt                   DateTime?
  changeRequestReason        String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  asset                      Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  originatingCollector       User                      @relation("InitialOfferingOriginator", fields: [originatingCollectorUserId], references: [id], onDelete: Restrict)
  beneficiary                User                      @relation("InitialOfferingBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
  ownershipSupplyPolicy      OwnershipSupplyPolicy     @relation(fields: [ownershipSupplyPolicyId], references: [id], onDelete: Restrict)
  valuationDecision          ValuationDecision         @relation(fields: [valuationDecisionId], references: [id], onDelete: Restrict)
  inventory                  InitialOfferingInventory?
  orders                     TradingOrder[]
  executions                 TradingExecution[]

  @@index([originatingCollectorUserId, status, updatedAt, id])
  @@index([beneficiaryUserId, status, updatedAt, id])
  @@index([status, updatedAt, assetId])
}

model InitialOfferingInventory {
  id                String           @id @default(cuid())
  offeringId        String           @unique
  assetId           String
  accountId         String           @unique
  beneficiaryUserId String
  offeredUnits      BigInt
  availableUnits    BigInt
  reservedUnits     BigInt           @default(0)
  settledUnits      BigInt           @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  offering          InitialOffering  @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  asset             Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  account           OwnershipAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  beneficiary       User             @relation("InitialOfferingInventoryBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)

  @@index([assetId, createdAt, id])
  @@index([beneficiaryUserId, createdAt, id])
}

/// Materialized ownership position. Available units are settled minus reserved;
/// constraints in the migration prevent a negative projection.
model OwnershipPosition {
  id            String                 @id @default(cuid())
  assetId       String
  accountId     String
  settledUnits  BigInt                 @default(0)
  reservedUnits BigInt                 @default(0)
  version       Int                    @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  supply        OwnershipAssetSupply   @relation(fields: [assetId], references: [assetId], onDelete: Restrict)
  account       OwnershipAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reservations  OwnershipReservation[]

  @@unique([assetId, accountId])
  @@index([accountId, assetId])
}

model OwnershipReservation {
  id             String                     @id @default(cuid())
  assetId        String
  accountId      String
  purposeType    String
  purposeId      String
  units          BigInt
  status         OwnershipReservationStatus @default(ACTIVE)
  expiresAt      DateTime?
  idempotencyRef String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  position       OwnershipPosition          @relation(fields: [assetId, accountId], references: [assetId, accountId], onDelete: Restrict)

  @@unique([assetId, accountId, purposeType, purposeId])
  @@index([assetId, accountId, status, expiresAt])
}

/// Append-only ownership quantities and sequences. It holds no cash, price,
/// payment, or investor data.
model OwnershipLedgerEntry {
  id                  String                   @id @default(cuid())
  assetId             String
  sequence            BigInt
  entryType           OwnershipLedgerEntryType
  debitAccountId      String?
  creditAccountId     String?
  units               BigInt
  correlationId       String
  causationId         String?
  idempotencyRecordId String?
  reasonCode          String?
  metadata            Json?
  actorUserId         String?
  createdAt           DateTime                 @default(now())
  supply              OwnershipAssetSupply     @relation(fields: [assetId], references: [assetId], onDelete: Restrict)
  debitAccount        OwnershipAccount?        @relation("OwnershipLedgerDebit", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount       OwnershipAccount?        @relation("OwnershipLedgerCredit", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@unique([assetId, sequence])
  @@unique([assetId, correlationId, entryType])
  @@index([assetId, createdAt, id])
}

/// Immutable reconciliation observation. Reconciliation never repairs state;
/// any later repair must be a separately authorised compensating mutation.
model OwnershipReconciliationRun {
  id                  String                        @id @default(cuid())
  assetId             String
  status              OwnershipReconciliationStatus
  expectedIssuedUnits BigInt
  positionUnits       BigInt
  reservedUnits       BigInt
  ledgerUnits         BigInt
  mismatchCodes       Json
  actorUserId         String?
  createdAt           DateTime                      @default(now())

  @@index([assetId, createdAt, id])
}

/// Document 013's closed-loop GBP accounting principal. Accounts are private;
/// `AccountBalance` is only a replayable projection of the immutable journal.
model FinancialAccount {
  id             String                     @id @default(cuid())
  ownerType      FinancialAccountOwnerType
  ownerUserId    String?
  accountType    FinancialAccountType
  code           String
  currency       String
  normalSide     DebitCredit
  status         FinancialAccountStatus     @default(ACTIVE)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  owner          User?                      @relation("FinancialAccountUser", fields: [ownerUserId], references: [id], onDelete: Restrict)
  balance        AccountBalance?
  entries        JournalEntry[]
  reservations   CashReservation[]
  saleProceeds   ExternalSaleVerification[] @relation("SaleProceedsAccount")
  moneyMovements MoneyMovement[]            @relation("MovementCashAccount")

  @@unique([ownerType, ownerUserId, code, currency])
  @@index([ownerUserId, currency, status])
}

model JournalTransaction {
  id                        String                     @id @default(cuid())
  type                      JournalTransactionType
  status                    JournalTransactionStatus   @default(POSTED)
  currency                  String
  correlationId             String                     @unique
  descriptionCode           String
  reversalOfId              String?                    @unique
  createdByUserId           String?
  effectiveAt               DateTime                   @default(now())
  createdAt                 DateTime                   @default(now())
  reversalOf                JournalTransaction?        @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal                  JournalTransaction?        @relation("JournalReversal")
  entries                   JournalEntry[]
  saleProceeds              ExternalSaleVerification?  @relation("SaleProceedsJournal")
  moneyMovement             MoneyMovement?             @relation("MovementJournal")
  providerCost              ProviderFinancialCost?
  platformRevenueSettlement PlatformRevenueSettlement?

  @@index([currency, effectiveAt, id])
}

model JournalEntry {
  id            String             @id @default(cuid())
  transactionId String
  sequence      Int
  accountId     String
  side          DebitCredit
  amountMinor   BigInt
  currency      String
  createdAt     DateTime           @default(now())
  transaction   JournalTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, sequence])
  @@index([accountId, createdAt, id])
}

model AccountBalance {
  accountId         String           @id
  postedDebitMinor  BigInt           @default(0)
  postedCreditMinor BigInt           @default(0)
  reservedMinor     BigInt           @default(0)
  version           Int              @default(1)
  updatedAt         DateTime         @updatedAt
  account           FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model CashReservation {
  id          String                @id @default(cuid())
  accountId   String
  purposeType String
  purposeId   String
  amountMinor BigInt
  status      CashReservationStatus @default(ACTIVE)
  expiresAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  account     FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, purposeType, purposeId])
  @@index([accountId, status, expiresAt])
}

/// A returned bank debit can leave Slice with a customer recovery obligation
/// after the funded cash has already been spent. This is an explicit,
/// append-only state; ownership is not silently confiscated.
model FinancialDeficit {
  id               String                 @id @default(cuid())
  userId           String
  sourceMovementId String                 @unique
  currency         String
  amountMinor      BigInt
  recoveredMinor   BigInt                 @default(0)
  status           FinancialDeficitStatus @default(OPEN)
  reasonCode       String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  resolvedAt       DateTime?
  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceMovement   MoneyMovement          @relation(fields: [sourceMovementId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt, id])
}

/// Dual-control finance workflow for a narrowly scoped deficit adjustment.
/// This is a proposal and journal reference, never a mutable balance patch.
/// User and deficit identifiers are deliberately scalar so the workflow can
/// preserve historical records even if an account is later restricted.
model FinancialAdjustmentRequest {
  id                           String                    @id @default(cuid())
  userId                       String
  deficitId                    String
  initiatorUserId              String
  approverUserId               String?
  status                       FinancialAdjustmentStatus @default(DRAFT)
  currency                     String                    @default("GBP")
  amountMinor                  BigInt
  reason                       String
  idempotencyKeyHash           String                    @unique
  requestHash                  String
  submissionIdempotencyKeyHash String?                   @unique
  approvalIdempotencyKeyHash   String?                   @unique
  journalTransactionId         String?                   @unique
  beforeOutstandingMinor       BigInt
  afterOutstandingMinor        BigInt?
  restrictionReleased          Boolean?
  requestedAt                  DateTime                  @default(now())
  approvedAt                   DateTime?
  appliedAt                    DateTime?
  rejectedAt                   DateTime?
  rejectionReason              String?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  @@index([status, createdAt, id])
  @@index([userId, status, createdAt, id])
  @@index([deficitId, status, createdAt, id])
}

model PortfolioLot {
  id              String             @id @default(cuid())
  userId          String
  assetId         String
  acquiredUnits   BigInt
  remainingUnits  BigInt
  totalCostMinor  BigInt
  currency        String
  acquiredAt      DateTime           @default(now())
  sourceReference String             @unique
  status          PortfolioLotStatus @default(OPEN)
  createdAt       DateTime           @default(now())
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  asset           Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  disposals       LotDisposal[]

  @@index([userId, assetId, acquiredAt, id])
}

model LotDisposal {
  id                 String       @id @default(cuid())
  lotId              String
  sourceReference    String       @unique
  units              BigInt
  allocatedCostMinor BigInt
  proceedsMinor      BigInt
  feeMinor           BigInt
  realizedPnlMinor   BigInt
  createdAt          DateTime     @default(now())
  lot                PortfolioLot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt, id])
}

model FinancialReconciliationRun {
  id            String                        @id @default(cuid())
  scope         String
  status        FinancialReconciliationStatus
  currency      String
  debitMinor    BigInt
  creditMinor   BigInt
  mismatchCodes Json
  actorUserId   String?
  createdAt     DateTime                      @default(now())

  @@index([scope, createdAt, id])
}

model ComplianceCase {
  id                          String               @id @default(cuid())
  userId                      String
  provider                    ProviderCode
  type                        ComplianceCaseType
  status                      ComplianceCaseStatus @default(NOT_STARTED)
  identityState               String               @default("NOT_STARTED")
  providerReferenceCiphertext String?
  providerReferenceHash       String?
  encryptionKeyVersion        String?
  expiresAt                   DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  identityRequestedAt         DateTime?
  identityCompletedAt         DateTime?
  identityVerifiedAt          DateTime?
  identitySafeFailureCode     String?
  identityLastProviderSync    DateTime?
  user                        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  decisions                   ComplianceDecision[]

  @@unique([userId, provider, type])
  @@unique([provider, providerReferenceHash])
  @@index([userId, status, updatedAt])
  @@index([provider, status, updatedAt])
}

model ComplianceDecision {
  id                  String               @id @default(cuid())
  caseId              String
  status              ComplianceCaseStatus
  reasonCode          String
  providerEventIdHash String?
  actorUserId         String?
  createdAt           DateTime             @default(now())
  complianceCase      ComplianceCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor               User?                @relation("ComplianceDecisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([caseId, providerEventIdHash])
  @@index([caseId, createdAt, id])
}

model ExternalProviderCustomer {
  id                 String                      @id @default(cuid())
  userId             String
  provider           ProviderCode
  environment        ExternalProviderEnvironment
  externalCustomerId String
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  user               User                        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, environment, userId])
  @@unique([provider, environment, externalCustomerId])
  @@index([userId, provider, environment])
}

model FinancialConnectionSession {
  id                String                      @id @default(cuid())
  userId            String
  provider          ProviderCode
  environment       ExternalProviderEnvironment
  externalSessionId String
  status            String                      @default("CREATED")
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  user              User                        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, environment, externalSessionId])
  @@index([userId, provider, environment, status])
}

/// Provider-neutral record for a Stripe Bacs mandate setup attempt. This is
/// separate from the retained Financial Connections history so the retired US
/// funding flow cannot be mistaken for the active GBP rail.
model BacsSetupSession {
  id                                         String                      @id @default(cuid())
  userId                                     String
  provider                                   ProviderCode
  environment                                ExternalProviderEnvironment
  /// Legacy raw reference retained only for additive compatibility. New code
  /// must use the encrypted/hashed reference fields below.
  externalSetupIntentId                      String?
  externalCheckoutSessionReferenceCiphertext String?
  externalCheckoutSessionReferenceHash       String?                     @unique
  externalSetupIntentReferenceCiphertext     String?
  externalSetupIntentReferenceHash           String?                     @unique
  externalPaymentMethodReferenceCiphertext   String?
  externalPaymentMethodReferenceHash         String?                     @unique
  status                                     String                      @default("CREATED")
  createdAt                                  DateTime                    @default(now())
  updatedAt                                  DateTime                    @updatedAt
  user                                       User                        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, environment, externalSetupIntentId])
  @@index([userId, provider, environment, status])
}

model ExternalFinancialAccount {
  id                          String                      @id @default(cuid())
  userId                      String
  provider                    ProviderCode
  environment                 ExternalProviderEnvironment @default(SANDBOX)
  providerReferenceCiphertext String
  providerReferenceHash       String
  encryptionKeyVersion        String
  itemReferenceCiphertext     String?
  itemReferenceHash           String?
  accessTokenCiphertext       String?
  accessTokenHash             String?
  externalPaymentMethodId     String?
  institutionName             String?
  accountName                 String?
  accountMask                 String?
  currency                    String
  accountType                 String
  status                      String
  ownershipStatus             String?
  instrumentIdentityId        String?
  riskState                   BankRiskState               @default(CLEAR)
  riskReviewedAt              DateTime?
  isDefault                   Boolean                     @default(false)
  lastSyncedAt                DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  movements                   MoneyMovement[]
  instrumentIdentity          BankInstrumentIdentity?     @relation(fields: [instrumentIdentityId], references: [id], onDelete: SetNull)
  securityEvents              BankSecurityEvent[]

  @@unique([provider, providerReferenceHash])
  @@index([provider, environment, instrumentIdentityId])
  @@index([userId, provider, itemReferenceHash])
  @@index([userId, provider, status])
}

/// Provider-issued stable identity, stored only as a keyed application hash.
/// A shared identity is reviewable rather than globally unique at the user
/// level because legitimate shared household/business accounts exist.
model BankInstrumentIdentity {
  id                        String                      @id @default(cuid())
  provider                  ProviderCode
  environment               ExternalProviderEnvironment
  instrumentFingerprintHash String
  accountLast4              String?
  bankCountry               String?
  riskState                 BankRiskState               @default(CLEAR)
  firstSeenAt               DateTime                    @default(now())
  lastSeenAt                DateTime                    @updatedAt
  accounts                  ExternalFinancialAccount[]
  securityEvents            BankSecurityEvent[]

  @@unique([provider, environment, instrumentFingerprintHash])
  @@index([riskState, lastSeenAt])
}

/// Append-only bank lifecycle and fraud signals. Metadata is limited to safe
/// projections; raw account/routing values and credentials never belong here.
model BankSecurityEvent {
  id                   String                      @id @default(cuid())
  userId               String?
  externalAccountId    String?
  instrumentIdentityId String?
  provider             ProviderCode
  environment          ExternalProviderEnvironment
  eventType            String
  ipHash               String?
  metadata             Json?
  createdAt            DateTime                    @default(now())
  user                 User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  externalAccount      ExternalFinancialAccount?   @relation(fields: [externalAccountId], references: [id], onDelete: SetNull)
  instrumentIdentity   BankInstrumentIdentity?     @relation(fields: [instrumentIdentityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt, id])
  @@index([instrumentIdentityId, createdAt, id])
  @@index([eventType, createdAt])
}

model ExternalConnectAccount {
  id                          String                      @id @default(cuid())
  userId                      String
  provider                    ProviderCode
  environment                 ExternalProviderEnvironment
  externalAccountIdCiphertext String
  externalAccountIdHash       String
  encryptionKeyVersion        String
  status                      ConnectAccountStatus        @default(NOT_STARTED)
  requirementsSummary         Json?
  detailsSubmitted            Boolean                     @default(false)
  payoutsEnabled              Boolean                     @default(false)
  transfersCapability         String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  lastSyncedAt                DateTime?
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  payouts                     ConnectPayout[]

  @@unique([provider, environment, userId])
  @@unique([provider, environment, externalAccountIdHash])
  @@index([userId, provider, environment, status])
}

model MoneyMovement {
  id                                     String                        @id @default(cuid())
  userId                                 String
  externalAccountId                      String?
  cashAccountId                          String
  type                                   MoneyMovementType
  amountMinor                            BigInt
  /// Customer-entered gross amount. For withdrawals, this is the amount
  /// reserved/debited from the customer wallet.
  sliceFeeMinor                          BigInt                        @default(0)
  /// Provider-facing amount. Deposits equal amountMinor; withdrawals are
  /// gross less Slice's disclosed withdrawal fee.
  providerAmountMinor                    BigInt?
  currency                               String
  status                                 MoneyMovementStatus           @default(CREATED)
  provider                               ProviderCode
  providerReferenceCiphertext            String?
  providerReferenceHash                  String?
  providerBalanceTransactionIdCiphertext String?
  providerBalanceTransactionIdHash       String?
  providerFeeMinor                       BigInt?
  providerNetMinor                       BigInt?
  providerAvailableOn                    DateTime?
  providerCurrency                       String?
  providerSourceReferenceHash            String?
  encryptionKeyVersion                   String?
  idempotencyKeyHash                     String
  reservationId                          String?                       @unique
  ledgerTransactionId                    String?                       @unique
  failureCode                            String?
  version                                Int                           @default(1)
  createdAt                              DateTime                      @default(now())
  updatedAt                              DateTime                      @updatedAt
  settledAt                              DateTime?
  user                                   User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  externalAccount                        ExternalFinancialAccount?     @relation(fields: [externalAccountId], references: [id], onDelete: Restrict)
  cashAccount                            FinancialAccount              @relation("MovementCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)
  ledgerTransaction                      JournalTransaction?           @relation("MovementJournal", fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  connectPayout                          ConnectPayout?
  providerLiquidityReservation           ProviderLiquidityReservation?
  history                                MoneyMovementHistory[]
  holds                                  ComplianceHold[]
  financialDeficit                       FinancialDeficit?
  providerCosts                          ProviderFinancialCost[]

  @@unique([userId, type, idempotencyKeyHash])
  @@unique([provider, providerReferenceHash])
  @@unique([provider, providerBalanceTransactionIdHash])
  @@index([userId, createdAt, id])
  @@index([provider, status, updatedAt])
  @@index([provider, providerAvailableOn, status])
  @@index([status, createdAt, id])
}

model ProviderLiquidityReservation {
  id                       String                             @id @default(cuid())
  movementId               String                             @unique
  provider                 ProviderCode
  environment              ExternalProviderEnvironment
  currency                 String
  amountMinor              BigInt
  status                   ProviderLiquidityReservationStatus @default(ACTIVE)
  providerBalanceCheckedAt DateTime
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt
  movement                 MoneyMovement                      @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([provider, environment, currency, status, createdAt, id])
}

model ConnectPayout {
  id                           String                      @id @default(cuid())
  movementId                   String                      @unique
  connectAccountId             String
  provider                     ProviderCode
  environment                  ExternalProviderEnvironment
  amountMinor                  BigInt
  currency                     String
  status                       ConnectPayoutStatus         @default(CREATED)
  externalTransferIdCiphertext String?
  externalTransferIdHash       String?
  externalPayoutIdCiphertext   String?
  externalPayoutIdHash         String?
  encryptionKeyVersion         String?
  failureCode                  String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  lastSyncedAt                 DateTime?
  movement                     MoneyMovement               @relation(fields: [movementId], references: [id], onDelete: Restrict)
  connectAccount               ExternalConnectAccount      @relation(fields: [connectAccountId], references: [id], onDelete: Restrict)
  providerCosts                ProviderFinancialCost[]

  @@unique([provider, externalTransferIdHash])
  @@unique([provider, externalPayoutIdHash])
  @@index([connectAccountId, status, updatedAt])
  @@index([provider, environment, status, updatedAt])
}

model MoneyMovementHistory {
  id         String               @id @default(cuid())
  movementId String
  fromStatus MoneyMovementStatus?
  toStatus   MoneyMovementStatus
  reasonCode String
  createdAt  DateTime             @default(now())
  movement   MoneyMovement        @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([movementId, createdAt, id])
}

model WebhookInbox {
  id                   String             @id @default(cuid())
  provider             ProviderCode
  providerEventIdHash  String
  eventType            String
  payloadCiphertext    String?
  payloadHash          String
  encryptionKeyVersion String?
  signatureVerified    Boolean
  receivedAt           DateTime           @default(now())
  processedAt          DateTime?
  status               WebhookInboxStatus @default(ACCEPTED)
  attempts             Int                @default(0)
  errorCode            String?

  @@unique([provider, providerEventIdHash])
  @@index([provider, status, receivedAt, id])
}

model ProviderReconciliationRun {
  id            String                       @id @default(cuid())
  provider      ProviderCode
  status        ProviderReconciliationStatus
  actorUserId   String?
  createdAt     DateTime                     @default(now())
  discrepancies ProviderDiscrepancy[]

  @@index([provider, createdAt, id])
}

model ProviderDiscrepancy {
  id            String                    @id @default(cuid())
  runId         String
  code          String
  movementId    String?
  expectedMinor BigInt?
  actualMinor   BigInt?
  createdAt     DateTime                  @default(now())
  run           ProviderReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, code, id])
}

model ComplianceHold {
  id         String               @id @default(cuid())
  userId     String
  movementId String?
  scope      String
  reasonCode String
  source     String
  status     ComplianceHoldStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())
  releasedAt DateTime?
  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  movement   MoneyMovement?       @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([movementId, status])
}

model ProviderIncident {
  id          String                   @id @default(cuid())
  provider    ProviderCode
  severity    ProviderIncidentSeverity
  status      ProviderIncidentStatus   @default(OPEN)
  code        String
  ownerUserId String?
  createdAt   DateTime                 @default(now())
  resolvedAt  DateTime?
  owner       User?                    @relation("ProviderIncidentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([provider, status, severity, createdAt])
}

/// Provider fee evidence is persisted separately from customer movements and
/// Slice revenue. A missing provider balance transaction is explicitly
/// pending evidence; it is never represented as a guessed zero fee.
model ProviderFinancialCost {
  id                         String                      @id @default(cuid())
  provider                   ProviderCode
  environment                ExternalProviderEnvironment
  currency                   String
  amountMinor                BigInt?
  costType                   ProviderFinancialCostType
  sourceObjectType           String
  sourceObjectId             String
  balanceTransactionId       String?
  relatedMovementId          String?
  relatedConnectPayoutId     String?
  status                     ProviderFinancialCostStatus @default(PENDING_EVIDENCE)
  failureCode                String?
  observedAt                 DateTime?
  postedJournalTransactionId String?                     @unique
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  relatedMovement            MoneyMovement?              @relation(fields: [relatedMovementId], references: [id], onDelete: Restrict)
  relatedConnectPayout       ConnectPayout?              @relation(fields: [relatedConnectPayoutId], references: [id], onDelete: Restrict)
  postedJournalTransaction   JournalTransaction?         @relation(fields: [postedJournalTransactionId], references: [id], onDelete: Restrict)

  @@unique([provider, environment, sourceObjectType, sourceObjectId, costType])
  @@unique([provider, environment, balanceTransactionId])
  @@index([status, createdAt, id])
  @@index([relatedMovementId, status])
  @@index([relatedConnectPayoutId, status])
}

/// Dual-control snapshot of Slice-owned revenue eligible for settlement. It
/// never contains customer liabilities, Collector proceeds, or external
/// clearing balances. No external payout is implied by APPROVED.
model PlatformRevenueSettlement {
  id                         String                          @id @default(cuid())
  currency                   String
  grossRevenueMinor          BigInt
  providerExpensesMinor      BigInt
  eligibleSettlementMinor    BigInt
  requestedAmountMinor       BigInt
  requestIdempotencyKeyHash  String                          @unique
  approvalIdempotencyKeyHash String?                         @unique
  status                     PlatformRevenueSettlementStatus @default(DRAFT)
  externalStatus             String                          @default("NOT_CONFIGURED")
  requestedByUserId          String
  approvedByUserId           String?
  providerReference          String?
  journalTransactionId       String?                         @unique
  failureCode                String?
  requestedAt                DateTime                        @default(now())
  approvedAt                 DateTime?
  processingAt               DateTime?
  settledAt                  DateTime?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  requestedBy                User                            @relation("PlatformRevenueSettlementRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy                 User?                           @relation("PlatformRevenueSettlementApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  journalTransaction         JournalTransaction?             @relation(fields: [journalTransactionId], references: [id], onDelete: Restrict)
  lines                      PlatformRevenueSettlementLine[]

  @@index([status, createdAt, id])
  @@index([requestedByUserId, createdAt, id])
}

model PlatformRevenueSettlementLine {
  id           String                    @id @default(cuid())
  settlementId String
  category     String
  sourceType   String
  sourceId     String
  amountMinor  BigInt
  currency     String
  createdAt    DateTime                  @default(now())
  settlement   PlatformRevenueSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([settlementId, category, sourceType, sourceId])
  @@index([sourceType, sourceId])
}

/// Document 014 local/test market configuration. Production trading hours and
/// fee schedules remain outside this model until separately approved.
model TradingMarket {
  assetId               String              @id
  status                TradingMarketStatus @default(OPEN)
  tickSizeMinor         BigInt              @default(1)
  lotSizeUnits          BigInt              @default(1)
  minimumNotionalMinor  BigInt              @default(100)
  makerFeeBps           Int                 @default(0)
  takerFeeBps           Int                 @default(0)
  selfTradePrevention   String              @default("REJECT_TAKER")
  tradingEnabled        Boolean             @default(true)
  feeScheduleVersion    String              @default("ZERO_TRADING_FEES_V2")
  nextPrioritySequence  BigInt              @default(1)
  nextExecutionSequence BigInt              @default(1)
  version               Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  asset                 Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  orders                TradingOrder[]
  executions            TradingExecution[]

  @@index([status, updatedAt, assetId])
}

/// Durable order intent. Reservation references are opaque internal links; no
/// public projection exposes them.
model TradingOrder {
  id                     String               @id @default(cuid())
  userId                 String?
  principalType          TradingPrincipalType @default(USER)
  channel                TradingChannel       @default(SECONDARY_MARKET)
  principalId            String
  initialOfferingId      String?
  actorUserId            String?
  assetId                String
  side                   TradingOrderSide
  type                   TradingOrderType     @default(LIMIT)
  timeInForce            TradingTimeInForce
  status                 TradingOrderStatus   @default(PENDING_RESERVATION)
  limitPriceMinor        BigInt
  originalUnits          BigInt
  remainingUnits         BigInt
  filledUnits            BigInt               @default(0)
  averageFillPriceMinor  BigInt?
  prioritySequence       BigInt?
  cashReservationId      String?
  ownershipReservationId String?
  idempotencyRecordId    String?
  expiresAt              DateTime?
  closedAt               DateTime?
  version                Int                  @default(1)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User?                @relation("TradingOrderUser", fields: [userId], references: [id], onDelete: Restrict)
  actorUser              User?                @relation("TradingOrderActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  initialOffering        InitialOffering?     @relation(fields: [initialOfferingId], references: [id], onDelete: Restrict)
  asset                  Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict, map: "TradingOrder_asset_fkey")
  market                 TradingMarket        @relation(fields: [assetId], references: [assetId], onDelete: Restrict, map: "TradingOrder_market_fkey")
  statusHistory          OrderStatusHistory[]
  buyExecutions          TradingExecution[]   @relation("ExecutionBuyOrder")
  sellExecutions         TradingExecution[]   @relation("ExecutionSellOrder")
  makerExecutions        TradingExecution[]   @relation("ExecutionMakerOrder")
  takerExecutions        TradingExecution[]   @relation("ExecutionTakerOrder")

  @@index([assetId, side, status, limitPriceMinor, prioritySequence])
  @@index([userId, createdAt, id])
  @@index([principalType, principalId, createdAt, id])
  @@index([initialOfferingId, status, createdAt, id])
  @@index([actorUserId, createdAt, id])
  @@index([assetId, status, createdAt, id])
  @@index([assetId, status, expiresAt, id])
}

/// Append-only externally-safe execution record. Settlement is internal and
/// atomic in Document 014; this record never carries financial account IDs.
model TradingExecution {
  id                String                           @id @default(cuid())
  assetId           String
  channel           TradingChannel                   @default(SECONDARY_MARKET)
  initialOfferingId String?
  buyOrderId        String
  sellOrderId       String
  makerOrderId      String
  takerOrderId      String
  priceMinor        BigInt
  units             BigInt
  grossMinor        BigInt
  buyerFeeMinor     BigInt                           @default(0)
  sellerFeeMinor    BigInt                           @default(0)
  marketSequence    BigInt
  settlementStatus  TradingExecutionSettlementStatus @default(SETTLED)
  correlationId     String                           @unique
  executedAt        DateTime                         @default(now())
  settledAt         DateTime                         @default(now())
  asset             Asset                            @relation(fields: [assetId], references: [id], onDelete: Restrict, map: "TradingExecution_asset_fkey")
  market            TradingMarket                    @relation(fields: [assetId], references: [assetId], onDelete: Restrict, map: "TradingExecution_market_fkey")
  buyOrder          TradingOrder                     @relation("ExecutionBuyOrder", fields: [buyOrderId], references: [id], onDelete: Restrict)
  sellOrder         TradingOrder                     @relation("ExecutionSellOrder", fields: [sellOrderId], references: [id], onDelete: Restrict)
  makerOrder        TradingOrder                     @relation("ExecutionMakerOrder", fields: [makerOrderId], references: [id], onDelete: Restrict)
  takerOrder        TradingOrder                     @relation("ExecutionTakerOrder", fields: [takerOrderId], references: [id], onDelete: Restrict)
  initialOffering   InitialOffering?                 @relation(fields: [initialOfferingId], references: [id], onDelete: Restrict)

  @@unique([assetId, marketSequence])
  @@index([assetId, executedAt, id])
}

/// Immutable state-transition audit distinct from generic access audit.
/// Durable, provider-neutral event envelope. Payloads are validated plain JSON
/// and never carry raw provider/compliance or financial-account authority.
model OutboxEvent {
  id             String                 @id @default(cuid())
  eventId        String                 @unique
  eventType      String
  aggregateType  String
  aggregateId    String
  schemaVersion  Int
  occurredAt     DateTime
  payload        Json
  metadata       Json?
  correlationId  String?
  causationId    String?
  actorUserId    String?
  status         OutboxEventStatus      @default(PENDING)
  attempts       Int                    @default(0)
  availableAt    DateTime               @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  claimToken     String?                @unique
  leaseExpiresAt DateTime?
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  deadLetteredAt DateTime?
  lastErrorSafe  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deliveries     NotificationDelivery[]

  @@index([status, availableAt, createdAt, id])
  @@index([status, leaseExpiresAt, id])
  @@index([aggregateType, aggregateId, occurredAt, id])
  @@index([correlationId])
}

/// Durable downstream delivery work. PENDING is not evidence of external delivery.
model NotificationDelivery {
  id             String                      @id @default(cuid())
  deliveryId     String                      @unique
  outboxEventId  String
  channel        NotificationDeliveryChannel
  destinationKey String
  classification String
  topic          String
  mandatory      Boolean                     @default(false)
  payloadVersion Int
  payload        Json
  idempotencyKey String                      @unique
  status         NotificationDeliveryStatus  @default(PENDING)
  attempts       Int                         @default(0)
  availableAt    DateTime                    @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  claimToken     String?                     @unique
  leaseExpiresAt DateTime?
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  deadLetteredAt DateTime?
  lastErrorSafe  String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  outboxEvent    OutboxEvent                 @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@unique([outboxEventId, channel, destinationKey])
  @@index([status, availableAt, createdAt, id])
  @@index([status, leaseExpiresAt, id])
  @@index([outboxEventId, createdAt, id])
}

model OrderStatusHistory {
  id         String              @id @default(cuid())
  orderId    String
  fromStatus TradingOrderStatus?
  toStatus   TradingOrderStatus
  reasonCode String?
  createdAt  DateTime            @default(now())
  order      TradingOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt, id])
}

model CollectorFollow {
  followerUserId String
  followedUserId String
  createdAt      DateTime @default(now())
  follower       User     @relation("CollectorFollower", fields: [followerUserId], references: [id], onDelete: Cascade)
  followed       User     @relation("CollectorFollowed", fields: [followedUserId], references: [id], onDelete: Cascade)

  @@id([followerUserId, followedUserId])
  @@index([followedUserId, createdAt, followerUserId])
}

model DiscussionPost {
  id        String               @id @default(cuid())
  assetId   String
  userId    String
  parentId  String?
  body      String
  status    DiscussionPostStatus @default(VISIBLE)
  editedAt  DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  asset     Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict)
  user      User                 @relation("DiscussionAuthor", fields: [userId], references: [id], onDelete: Restrict)
  parent    DiscussionPost?      @relation("DiscussionReply", fields: [parentId], references: [id], onDelete: Restrict)
  replies   DiscussionPost[]     @relation("DiscussionReply")
  reports   ContentReport[]
  actions   ModerationAction[]

  @@index([assetId, status, createdAt, id])
  @@index([userId, createdAt, id])
}

model ContentReport {
  id             String              @id @default(cuid())
  postId         String
  reporterUserId String
  reasonCode     String
  status         ContentReportStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  post           DiscussionPost      @relation(fields: [postId], references: [id], onDelete: Restrict)
  reporter       User                @relation("ContentReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  actions        ModerationAction[]

  @@unique([postId, reporterUserId])
  @@index([status, createdAt, id])
}

model ModerationAction {
  id            String               @id @default(cuid())
  postId        String
  reportId      String?
  moderatorId   String
  action        ModerationActionType
  reasonCode    String
  internalNotes String?
  createdAt     DateTime             @default(now())
  post          DiscussionPost       @relation(fields: [postId], references: [id], onDelete: Restrict)
  report        ContentReport?       @relation(fields: [reportId], references: [id], onDelete: Restrict)
  moderator     User                 @relation("ModerationActor", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([postId, createdAt, id])
  @@index([reportId, createdAt, id])
}

model SaleProposal {
  id               String                    @id @default(cuid())
  assetId          String
  proposerId       String
  status           SaleProposalStatus        @default(DRAFT)
  offerMinor       BigInt
  currency         String
  policyVersion    String
  opensAt          DateTime?
  closesAt         DateTime?
  snapshotSequence BigInt?
  eligibleUnits    BigInt                    @default(0)
  quorumBps        Int
  approvalBps      Int
  votingEnabled    Boolean                   @default(false)
  version          Int                       @default(1)
  closedAt         DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  asset            Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  proposer         User                      @relation("SaleProposer", fields: [proposerId], references: [id], onDelete: Restrict)
  eligibility      ProposalEligibility[]
  votes            ProposalVote[]
  externalSale     ExternalSaleVerification?
  distribution     Distribution?

  @@index([assetId, status, createdAt, id])
  @@index([status, closesAt, id])
}

model ProposalEligibility {
  id         String             @id @default(cuid())
  proposalId String
  accountId  String
  userId     String?
  units      BigInt
  createdAt  DateTime           @default(now())
  proposal   SaleProposal       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  account    OwnershipAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user       User?              @relation("EligibilityUser", fields: [userId], references: [id], onDelete: Restrict)
  votes      ProposalVote[]
  lines      DistributionLine[]

  @@unique([proposalId, accountId])
  @@index([proposalId, userId, id])
}

model ProposalVote {
  id            String              @id @default(cuid())
  proposalId    String
  eligibilityId String
  castByUserId  String
  choice        ProposalVoteChoice
  weightUnits   BigInt
  sequence      Int
  isCurrent     Boolean             @default(true)
  createdAt     DateTime            @default(now())
  proposal      SaleProposal        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  eligibility   ProposalEligibility @relation(fields: [eligibilityId], references: [id], onDelete: Restrict)
  castBy        User                @relation("VoteCaster", fields: [castByUserId], references: [id], onDelete: Restrict)

  @@unique([proposalId, eligibilityId, sequence])
  @@index([proposalId, isCurrent, createdAt, id])
}

model ExternalSaleVerification {
  id                String                             @id @default(cuid())
  proposalId        String                             @unique
  status            ExternalSaleVerificationStatus     @default(PENDING)
  grossMinor        BigInt
  currency          String
  soldAt            DateTime
  externalReference String
  evidenceReference String
  custodyConfirmed  Boolean                            @default(false)
  proceedsAccountId String
  proceedsJournalId String
  verifierUserId    String?
  verifiedAt        DateTime?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  proposal          SaleProposal                       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  verifier          User?                              @relation("SaleVerifier", fields: [verifierUserId], references: [id], onDelete: Restrict)
  proceedsAccount   FinancialAccount                   @relation("SaleProceedsAccount", fields: [proceedsAccountId], references: [id], onDelete: Restrict)
  proceedsJournal   JournalTransaction                 @relation("SaleProceedsJournal", fields: [proceedsJournalId], references: [id], onDelete: Restrict)
  approvals         ExternalSaleVerificationApproval[]

  @@unique([proceedsJournalId])
}

model ExternalSaleVerificationApproval {
  id                 String                   @id @default(cuid())
  saleVerificationId String
  verifierUserId     String
  createdAt          DateTime                 @default(now())
  saleVerification   ExternalSaleVerification @relation(fields: [saleVerificationId], references: [id], onDelete: Restrict)
  verifier           User                     @relation("SaleVerificationApprover", fields: [verifierUserId], references: [id], onDelete: Restrict)

  @@unique([saleVerificationId, verifierUserId])
  @@index([saleVerificationId, createdAt, id])
}

model Distribution {
  id                   String                          @id @default(cuid())
  proposalId           String                          @unique
  status               DistributionStatus              @default(PENDING)
  grossMinor           BigInt
  feeMinor             BigInt                          @default(0)
  netMinor             BigInt
  currency             String
  policyVersion        String
  financeTransactionId String?                         @unique
  attemptCount         Int                             @default(0)
  failureCode          String?
  completedAt          DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  proposal             SaleProposal                    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  lines                DistributionLine[]
  reconciliations      DistributionReconciliationRun[]

  @@index([status, createdAt, id])
}

model DistributionLine {
  id             String              @id @default(cuid())
  distributionId String
  eligibilityId  String
  units          BigInt
  amountMinor    BigInt
  remainderRank  Int
  createdAt      DateTime            @default(now())
  distribution   Distribution        @relation(fields: [distributionId], references: [id], onDelete: Restrict)
  eligibility    ProposalEligibility @relation(fields: [eligibilityId], references: [id], onDelete: Restrict)

  @@unique([distributionId, eligibilityId])
  @@index([distributionId, remainderRank, id])
}

model DistributionReconciliationRun {
  id             String                           @id @default(cuid())
  distributionId String
  status         DistributionReconciliationStatus
  grossMinor     BigInt
  feeMinor       BigInt
  netMinor       BigInt
  lineMinor      BigInt
  mismatchCodes  Json
  actorUserId    String?
  createdAt      DateTime                         @default(now())
  distribution   Distribution                     @relation(fields: [distributionId], references: [id], onDelete: Restrict)

  @@index([distributionId, createdAt, id])
}

/// Guild-scoped configuration for the bot's Discord-only setup system.
/// Slice product data must never be placed in these tables.
model DiscordGuildConfig {
  guildId                 String                          @id
  setupVersion            Int                             @default(0)
  setupStatus             DiscordSetupStatus              @default(NOT_CONFIGURED)
  settings                Json?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  resources               DiscordManagedResource[]
  panels                  DiscordPanel[]
  notificationPreferences DiscordNotificationPreference[]
  tickets                 DiscordTicket[]

  @@index([setupStatus, updatedAt])
}

/// A reference to a resource Slice AI owns operationally. The logical key,
/// rather than a display name, is the reconciliation authority.
model DiscordManagedResource {
  id               String                     @id @default(cuid())
  guildId          String
  resourceType     DiscordManagedResourceType
  logicalKey       String
  discordId        String
  expectedName     String
  parentLogicalKey String?
  setupVersion     Int
  metadata         Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  guild            DiscordGuildConfig         @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, resourceType, logicalKey])
  @@index([guildId, discordId])
  @@index([guildId, resourceType])
}

/// Canonical rendered Discord panel reference. It is separated from generic
/// managed resources because panel message replacement is a normal repair.
model DiscordPanel {
  id          String             @id @default(cuid())
  guildId     String
  logicalKey  String
  channelId   String
  messageId   String
  templateKey String
  artworkKey  String?
  version     Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  guild       DiscordGuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, logicalKey])
  @@index([guildId, channelId])
}

model DiscordNotificationPreference {
  id            String             @id @default(cuid())
  guildId       String
  discordUserId String
  logicalKey    String
  enabled       Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  guild         DiscordGuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, discordUserId, logicalKey])
  @@index([guildId, discordUserId])
}

model DiscordTicket {
  id                           String                        @id @default(cuid())
  guildId                      String
  creatorDiscordId             String
  category                     String
  channelId                    String?                       @unique
  subject                      String
  safeSummary                  String
  safeReferenceId              String?
  status                       DiscordTicketStatus           @default(OPEN)
  priority                     DiscordTicketPriority         @default(NORMAL)
  assignedStaffId              String?
  assignedTeamKey              String?
  firstStaffResponseAt         DateTime?
  firstResponseDueAt           DateTime?
  resolutionDueAt              DateTime?
  firstResponseRiskAlertedAt   DateTime?
  firstResponseBreachAlertedAt DateTime?
  resolutionRiskAlertedAt      DateTime?
  resolutionBreachAlertedAt    DateTime?
  protectedFromAutoClose       Boolean                       @default(false)
  lastActivityAt               DateTime                      @default(now())
  inactivityWarnedAt           DateTime?
  resolvedAt                   DateTime?
  closedAt                     DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  guild                        DiscordGuildConfig            @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  events                       DiscordTicketEvent[]
  transcript                   DiscordTicketTranscript?
  staffTranscript              DiscordTicketStaffTranscript?
  formVersion                  DiscordTicketFormVersion?     @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  formVersionId                String?
  intakeResponses              DiscordTicketIntakeResponse[]
  internalNotes                DiscordTicketInternalNote[]
  tagAssignments               DiscordTicketTagAssignment[]

  @@index([guildId, creatorDiscordId, status])
  @@index([guildId, status, lastActivityAt])
  @@index([guildId, assignedStaffId, status])
}

/// Per-category operational policy. It controls support routing and timing,
/// never customer permissions, financial workflows, or identity authority.
model DiscordTicketCategoryPolicy {
  id                     String                @id @default(cuid())
  guildId                String
  category               String
  routingRoleKey         String?
  defaultPriority        DiscordTicketPriority @default(NORMAL)
  firstResponseMinutes   Int                   @default(240)
  resolutionMinutes      Int                   @default(2880)
  inactivityWarningHours Int                   @default(48)
  inactivityCloseHours   Int                   @default(120)
  protectedFromAutoClose Boolean               @default(false)
  enabled                Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([guildId, category])
  @@index([guildId, enabled])
}

/// Guild-scoped, versioned support intake schema. Existing tickets retain a
/// relation to the exact version used at creation.
model DiscordTicketFormVersion {
  id        String          @id @default(cuid())
  guildId   String
  category  String
  version   Int
  fields    Json
  active    Boolean         @default(true)
  createdBy String?
  createdAt DateTime        @default(now())
  tickets   DiscordTicket[]

  @@unique([guildId, category, version])
  @@index([guildId, category, active])
}

/// Answers are private support data; field label and type are snapshotted so
/// later form edits cannot change the meaning of historic tickets.
model DiscordTicketIntakeResponse {
  id         String        @id @default(cuid())
  ticketId   String
  fieldKey   String
  fieldLabel String
  fieldType  String
  value      String
  createdAt  DateTime      @default(now())
  ticket     DiscordTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, fieldKey])
  @@index([ticketId, createdAt])
}

model DiscordTicketInternalNote {
  id                  String        @id @default(cuid())
  ticketId            String
  authorDiscordUserId String
  content             String
  referencedMessageId String?
  createdAt           DateTime      @default(now())
  ticket              DiscordTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model DiscordTicketTag {
  id          String                       @id @default(cuid())
  guildId     String
  key         String
  label       String
  enabled     Boolean                      @default(true)
  sortOrder   Int                          @default(0)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  assignments DiscordTicketTagAssignment[]

  @@unique([guildId, key])
  @@index([guildId, enabled, sortOrder])
}

model DiscordTicketTagAssignment {
  ticketId  String
  tagId     String
  addedBy   String
  createdAt DateTime         @default(now())
  ticket    DiscordTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag       DiscordTicketTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([ticketId, tagId])
  @@index([tagId, createdAt])
}

model DiscordTicketEvent {
  id             String        @id @default(cuid())
  ticketId       String
  type           String
  actorDiscordId String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  ticket         DiscordTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model DiscordTicketTranscript {
  id                String                        @id @default(cuid())
  ticketId          String                        @unique
  status            DiscordTicketTranscriptStatus @default(COMPLETE)
  content           String
  messageCount      Int                           @default(0)
  failureReason     String?
  deliveryChannelId String?
  deliveredAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  ticket            DiscordTicket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

/// Staff-only companion transcript. It is deliberately separate from the
/// customer-safe transcript so private notes can never be delivered by reuse.
model DiscordTicketStaffTranscript {
  id            String                        @id @default(cuid())
  ticketId      String                        @unique
  status        DiscordTicketTranscriptStatus @default(COMPLETE)
  content       String
  messageCount  Int                           @default(0)
  failureReason String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  ticket        DiscordTicket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

/// Aggregate-only Discord operational telemetry. It intentionally excludes
/// message content, ticket content, command arguments, and financial data.
model DiscordAnalyticsDailyGuild {
  id                String   @id @default(cuid())
  guildId           String
  day               DateTime
  messages          Int      @default(0)
  supportMessages   Int      @default(0)
  joins             Int      @default(0)
  leaves            Int      @default(0)
  commandRuns       Int      @default(0)
  commandSuccesses  Int      @default(0)
  commandUserErrors Int      @default(0)
  commandDenied     Int      @default(0)
  commandFailures   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([guildId, day])
  @@index([guildId, day])
}

model DiscordAnalyticsDailyChannel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  day       DateTime
  messages  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId, day])
  @@index([guildId, day, messages])
}

model DiscordAnalyticsDailyCommand {
  id               String   @id @default(cuid())
  guildId          String
  day              DateTime
  commandName      String
  subcommand       String   @default("")
  runs             Int      @default(0)
  successes        Int      @default(0)
  userErrors       Int      @default(0)
  permissionDenied Int      @default(0)
  internalErrors   Int      @default(0)
  durationTotalMs  BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([guildId, day, commandName, subcommand])
  @@index([guildId, day, runs])
}

/// At most one daily row per guild/member. It supports accurate unique
/// activity counts without becoming a message or behavior archive.
model DiscordAnalyticsDailyMemberActivity {
  id                   String   @id @default(cuid())
  guildId              String
  discordUserId        String
  day                  DateTime
  messaged             Boolean  @default(false)
  usedCommand          Boolean  @default(false)
  communityInteraction Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([guildId, discordUserId, day])
  @@index([guildId, day])
}

model DiscordWorkerHeartbeat {
  workerName           String    @id
  instanceId           String
  lastStartedAt        DateTime
  lastHeartbeatAt      DateTime
  lastSuccessfulScanAt DateTime?
  lastErrorAt          DateTime?
  status               String    @default("HEALTHY")
  metadata             Json?
  updatedAt            DateTime  @updatedAt

  @@index([lastHeartbeatAt])
}

model DiscordModerationCase {
  id                     String                  @id @default(cuid())
  guildId                String
  caseNumber             Int
  targetDiscordUserId    String
  moderatorDiscordUserId String?
  action                 DiscordModerationAction
  source                 DiscordModerationSource
  status                 DiscordModerationStatus @default(PENDING)
  reason                 String
  expiresAt              DateTime?
  relatedMessageId       String?
  relatedChannelId       String?
  evidenceExcerpt        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([guildId, caseNumber])
  @@index([guildId, targetDiscordUserId, createdAt])
}

model DiscordModerationCounter {
  guildId        String @id
  nextCaseNumber Int    @default(1)
}

/// Guild-scoped, non-financial community progression authority. XP, levels,
/// reputation, and achievements never reference Slice accounts or balances.
model DiscordMemberProgression {
  id                    String                     @id @default(cuid())
  guildId               String
  discordUserId         String
  xp                    Int                        @default(0)
  level                 Int                        @default(1)
  reputation            Int                        @default(0)
  totalMessagesEligible Int                        @default(0)
  lastXpAt              DateTime?
  lastDailyClaimAt      DateTime?
  currentStreak         Int                        @default(0)
  longestStreak         Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  achievements          DiscordMemberAchievement[]

  @@unique([guildId, discordUserId])
  @@index([guildId, xp, discordUserId])
  @@index([guildId, reputation, discordUserId])
}

/// An append-only, guild-scoped audit trail for positive community reputation.
model DiscordReputationGrant {
  id                    String   @id @default(cuid())
  guildId               String
  giverDiscordUserId    String
  receiverDiscordUserId String
  amount                Int      @default(1)
  reason                String?
  createdAt             DateTime @default(now())

  @@index([guildId, giverDiscordUserId, createdAt])
  @@index([guildId, receiverDiscordUserId, createdAt])
}

/// One row per giver makes reputation cooldown acquisition atomic across bot processes.
model DiscordReputationCooldown {
  guildId            String
  giverDiscordUserId String
  nextAvailableAt    DateTime
  updatedAt          DateTime @updatedAt

  @@id([guildId, giverDiscordUserId])
}

/// Guild-scoped community feedback. It never represents product governance.
model DiscordSuggestion {
  id                   String                  @id @default(cuid())
  guildId              String
  referenceNumber      Int
  creatorDiscordUserId String
  content              String
  status               String                  @default("OPEN")
  messageId            String?                 @unique
  channelId            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  votes                DiscordSuggestionVote[]

  @@unique([guildId, referenceNumber])
  @@index([guildId, status, createdAt])
}

model DiscordSuggestionVote {
  id            String            @id @default(cuid())
  suggestionId  String
  discordUserId String
  value         Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  suggestion    DiscordSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, discordUserId])
  @@index([suggestionId, value])
}

model DiscordPoll {
  id                   String            @id @default(cuid())
  guildId              String
  creatorDiscordUserId String
  question             String
  options              Json
  status               String            @default("OPEN")
  closesAt             DateTime?
  messageId            String?           @unique
  channelId            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  votes                DiscordPollVote[]

  @@index([guildId, status, closesAt])
}

model DiscordPollVote {
  id            String      @id @default(cuid())
  pollId        String
  discordUserId String
  optionIndex   Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  poll          DiscordPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, discordUserId])
  @@index([pollId, optionIndex])
}

/// Stores only month and day; Slice does not collect a member's age or birth year.
model DiscordBirthday {
  guildId         String
  discordUserId   String
  month           Int
  day             Int
  lastAnnouncedOn String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([guildId, discordUserId])
  @@index([guildId, month, day])
}

/// Durable dedupe marker for community posts and announcements across restarts.
model DiscordCommunityScheduleState {
  guildId       String
  scheduleKey   String
  lastPeriodKey String
  lastPostedAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([guildId, scheduleKey])
}

/// Bot-owned community engagement state. A giveaway never represents a
/// purchase, investment, wallet, balance, ownership, or product entitlement.
model DiscordMemeCompetition {
  id                          String                             @id @default(cuid())
  guildId                     String
  channelId                   String
  periodKey                   String
  announcementMessageId       String?                            @unique
  startsAt                    DateTime
  endsAt                      DateTime
  status                      DiscordMemeCompetitionStatus       @default(OPEN)
  rewardXp                    Int
  winnerDiscordUserId         String?
  winningSubmissionId         String?
  closingClaimedAt            DateTime?
  closedAt                    DateTime?
  awardedAt                   DateTime?
  resultAnnouncedAt           DateTime?
  resultAnnouncementClaimedAt DateTime?
  createdAt                   DateTime                           @default(now())
  updatedAt                   DateTime                           @updatedAt
  submissions                 DiscordMemeSubmission[]
  award                       DiscordMemeAward?
  auditEvents                 DiscordMemeCompetitionAuditEvent[]

  @@unique([guildId, periodKey])
  @@index([guildId, status, endsAt])
  @@index([status, endsAt])
}

/// A registered Discord message reference only. Meme media itself stays in Discord.
model DiscordMemeSubmission {
  id             String                 @id @default(cuid())
  competitionId  String
  guildId        String
  channelId      String
  messageId      String                 @unique
  discordUserId  String
  submittedAt    DateTime               @default(now())
  invalidatedAt  DateTime?
  invalidReason  String?
  finalVoteCount Int?
  competition    DiscordMemeCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, discordUserId])
  @@index([competitionId, invalidatedAt])
  @@index([guildId, channelId, messageId])
}

/// One per competition is the durable exactly-once marker for existing bot XP.
model DiscordMemeAward {
  id                     String                 @id @default(cuid())
  competitionId          String                 @unique
  recipientDiscordUserId String
  xpAmount               Int
  awardedAt              DateTime               @default(now())
  competition            DiscordMemeCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([recipientDiscordUserId, awardedAt])
}

/// Append-only operational audit for the weekly Discord meme lifecycle.
model DiscordMemeCompetitionAuditEvent {
  id             String                            @id @default(cuid())
  competitionId  String
  action         DiscordMemeCompetitionAuditAction
  actorDiscordId String
  details        Json?
  createdAt      DateTime                          @default(now())
  competition    DiscordMemeCompetition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, createdAt])
  @@index([action, createdAt])
}

model DiscordGiveaway {
  id                              String                      @id @default(cuid())
  guildId                         String
  channelId                       String?
  messageId                       String?                     @unique
  createdByDiscordUserId          String
  title                           String
  description                     String?
  startsAt                        DateTime                    @default(now())
  endsAt                          DateTime
  status                          DiscordGiveawayStatus       @default(OPEN)
  winnerCount                     Int
  endedAt                         DateTime?
  endedByDiscordUserId            String?
  cancelledAt                     DateTime?
  cancelledByDiscordUserId        String?
  completionAnnouncedAt           DateTime?
  completionAnnouncementClaimedAt DateTime?
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  entries                         DiscordGiveawayEntry[]
  winners                         DiscordGiveawayWinner[]
  auditEvents                     DiscordGiveawayAuditEvent[]

  @@index([guildId, status])
  @@index([status, endsAt])
}

model DiscordGiveawayEntry {
  id            String          @id @default(cuid())
  giveawayId    String
  discordUserId String
  enteredAt     DateTime        @default(now())
  giveaway      DiscordGiveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, discordUserId])
  @@index([giveawayId])
}

/// Every result is retained. Rerolls never overwrite the original winner set.
model DiscordGiveawayWinner {
  id                  String                       @id @default(cuid())
  giveawayId          String
  discordUserId       String
  selectionType       DiscordGiveawaySelectionType
  rerollSequence      Int                          @default(0)
  selectedAt          DateTime                     @default(now())
  selectedByDiscordId String
  giveaway            DiscordGiveaway              @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, discordUserId, selectionType, rerollSequence])
  @@index([giveawayId, selectionType, rerollSequence])
}

/// Append-only Discord operational audit trail for giveaway actions.
model DiscordGiveawayAuditEvent {
  id             String                     @id @default(cuid())
  giveawayId     String
  action         DiscordGiveawayAuditAction
  actorDiscordId String
  details        Json?
  createdAt      DateTime                   @default(now())
  giveaway       DiscordGiveaway            @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@index([giveawayId, createdAt])
}

/// Discord-only public-profile controls. Financial data is never stored here.
model DiscordInvestorProfilePreference {
  guildId       String
  discordUserId String
  visibility    String   @default("MEMBERS_ONLY")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([guildId, discordUserId])
  @@index([guildId, visibility])
}

/// Bot-side idempotency record for backend-approved Discord deliveries only.
model DiscordDeliveryReceipt {
  id                 String   @id @default(cuid())
  guildId            String
  backendDeliveryId  String   @unique
  backendEventId     String
  logicalDestination String
  discordChannelId   String?
  discordMessageId   String?
  status             String   @default("PENDING")
  failureCode        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([guildId, logicalDestination, status])
  @@index([backendEventId])
}

/// Discord-only alert preference. It cannot create orders or affect valuation.
model DiscordPriceAlert {
  id                 String                      @id @default(cuid())
  guildId            String
  discordUserId      String
  assetId            String
  condition          String
  thresholdMinor     BigInt
  currency           String?
  enabled            Boolean                     @default(true)
  lastEvaluatedMinor BigInt?
  lastConditionMet   Boolean?
  lastObservedAt     DateTime?
  lastSource         String?
  lastDataStatus     String?
  lastTriggeredAt    DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  deliveries         DiscordPriceAlertDelivery[]

  @@index([guildId, assetId, enabled])
  @@index([guildId, discordUserId, enabled])
}

/// Durable private-delivery claims for bot-owned threshold alerts. A claimed
/// send is never automatically replayed after an uncertain Discord outcome.
model DiscordPriceAlertDelivery {
  id               String            @id @default(cuid())
  alertId          String
  idempotencyKey   String            @unique
  assetTitle       String
  observedMinor    BigInt
  currency         String
  source           String
  dataStatus       String
  observedAt       DateTime
  status           String            @default("PENDING")
  attempts         Int               @default(0)
  claimedAt        DateTime?
  deliveredAt      DateTime?
  discordChannelId String?
  discordMessageId String?
  failureCode      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  alert            DiscordPriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([alertId, status])
}

/// One durable claim per guild and UTC digest period. It contains no market
/// snapshot, only publication state and source metadata for idempotency.
model DiscordMarketDigestRun {
  id          String   @id @default(cuid())
  guildId     String
  periodKey   String
  status      String   @default("PUBLISHING")
  source      String
  dataStatus  String
  asOf        DateTime
  channelId   String?
  messageId   String?
  failureCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([guildId, periodKey])
  @@index([status, createdAt])
}

/// Poll state for an explicitly configured trusted news source. No article
/// body is retained, only conditional-request metadata and safe failure state.
model DiscordNewsSourceState {
  sourceId            String    @id
  lastPollAt          DateTime?
  lastSuccessAt       DateTime?
  etag                String?
  lastModified        String?
  nextPollAt          DateTime?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Metadata-only external-news record. `dedupKey` is stable across polling,
/// restarts, and harmless feed title changes; copyrighted article bodies are
/// intentionally never persisted.
model DiscordNewsItem {
  id               String                @id @default(cuid())
  sourceId         String
  dedupKey         String                @unique
  externalId       String?
  canonicalUrl     String
  canonicalUrlHash String
  title            String
  publishedAt      DateTime
  discoveredAt     DateTime              @default(now())
  category         DiscordNewsCategory
  priority         String
  summary          String
  contentHash      String
  status           DiscordNewsItemStatus @default(DISCOVERED)
  postedAt         DateTime?
  deliveries       DiscordNewsDelivery[]

  @@unique([sourceId, contentHash])
  @@index([sourceId, publishedAt])
  @@index([status, discoveredAt])
  @@index([canonicalUrlHash])
}

/// One public Discord destination receipt per discovered news item. The
/// unique key prevents a scheduler restart from reposting the same item.
model DiscordNewsDelivery {
  id               String                    @id @default(cuid())
  guildId          String
  channelId        String
  newsItemId       String
  status           DiscordNewsDeliveryStatus @default(PENDING)
  attempts         Int                       @default(0)
  claimedAt        DateTime?
  deliveredAt      DateTime?
  discordMessageId String?
  failureCode      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  newsItem         DiscordNewsItem           @relation(fields: [newsItemId], references: [id], onDelete: Cascade)

  @@unique([guildId, newsItemId])
  @@index([status, createdAt])
}

model DiscordEmbedDraft {
  id                   String                    @id @default(cuid())
  guildId              String
  creatorDiscordUserId String
  name                 String
  payload              Json
  linkButtons          Json
  targetChannelId      String?
  version              Int                       @default(1)
  lastPublishedAt      DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  publications         DiscordEmbedPublication[]
  auditEvents          DiscordEmbedAuditEvent[]

  @@index([guildId, deletedAt, updatedAt])
}

model DiscordEmbedPublication {
  id                       String                   @id @default(cuid())
  draftId                  String
  guildId                  String
  channelId                String
  messageId                String
  publishedByDiscordUserId String
  revisionUsed             Int
  publishedAt              DateTime                 @default(now())
  updatedAt                DateTime?
  deletedAt                DateTime?
  deletedByDiscordUserId   String?
  draft                    DiscordEmbedDraft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  auditEvents              DiscordEmbedAuditEvent[]

  @@unique([guildId, channelId, messageId])
  @@index([draftId, publishedAt])
}

model DiscordEmbedAuditEvent {
  id                 String                   @id @default(cuid())
  guildId            String
  draftId            String
  publicationId      String?
  actorDiscordUserId String
  action             DiscordEmbedAuditAction
  createdAt          DateTime                 @default(now())
  draft              DiscordEmbedDraft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  publication        DiscordEmbedPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([guildId, draftId, createdAt])
}

/// A bot-owned announcement intent. The local wall-clock definition is stored
/// alongside the UTC due time so recurring schedules remain correct through DST.
model DiscordAnnouncementSchedule {
  id                     String                                  @id @default(cuid())
  guildId                String
  draftId                String?
  createdByDiscordUserId String
  name                   String
  scheduleType           DiscordAnnouncementScheduleType
  timezone               String
  localTime              String
  localDate              String?
  weekdays               Json?
  dayOfMonth             Int?
  payloadMode            DiscordAnnouncementPayloadMode          @default(SNAPSHOT)
  payloadSnapshot        Json?
  linkButtonsSnapshot    Json?
  targetChannelId        String
  status                 DiscordAnnouncementScheduleStatus       @default(SCHEDULED)
  nextRunAt              DateTime?
  lastRunAt              DateTime?
  processingStartedAt    DateTime?
  leaseExpiresAt         DateTime?
  workerToken            String?
  pausedAt               DateTime?
  cancelledAt            DateTime?
  version                Int                                     @default(1)
  createdAt              DateTime                                @default(now())
  updatedAt              DateTime                                @updatedAt
  runs                   DiscordScheduledPublicationRun[]
  auditEvents            DiscordAnnouncementScheduleAuditEvent[]

  @@index([guildId, status, nextRunAt])
  @@index([status, leaseExpiresAt])
  @@index([draftId])
}

/// One durable run per scheduled occurrence. A send that may have reached
/// Discord is never automatically re-sent; it remains reviewable instead.
model DiscordScheduledPublicationRun {
  id               String                       @id @default(cuid())
  scheduleId       String
  scheduledFor     DateTime
  startedAt        DateTime                     @default(now())
  finishedAt       DateTime?
  status           DiscordAnnouncementRunStatus @default(PROCESSING)
  publicationId    String?
  discordChannelId String?
  discordMessageId String?
  errorCode        String?
  errorSummary     String?
  attemptCount     Int                          @default(1)
  workerToken      String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  schedule         DiscordAnnouncementSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledFor])
  @@index([scheduleId, createdAt])
  @@index([status, createdAt])
}

model DiscordAnnouncementScheduleAuditEvent {
  id                 String                                 @id @default(cuid())
  scheduleId         String
  actorDiscordUserId String
  action             DiscordAnnouncementScheduleAuditAction
  details            Json?
  createdAt          DateTime                               @default(now())
  schedule           DiscordAnnouncementSchedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, createdAt])
}

/// A public-only editorial spotlight. Source snapshots are refreshed before
/// publication, and no private Collector, ownership, or financial fields are
/// ever stored here.
model DiscordSpotlight {
  id                      String                       @id @default(cuid())
  guildId                 String
  kind                    DiscordSpotlightKind
  sourceSlug              String
  requesterDiscordUserId  String
  approvedByDiscordUserId String?
  status                  DiscordSpotlightStatus       @default(PENDING_APPROVAL)
  editorialTitle          String?
  editorialCopy           String?
  targetChannelId         String?
  embedDraftId            String?
  sourceSnapshot          Json
  publishedAt             DateTime?
  blockedReason           String?
  revision                Int                          @default(1)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  auditEvents             DiscordSpotlightAuditEvent[]

  @@index([guildId, status, createdAt])
  @@index([guildId, kind, sourceSlug, publishedAt])
}

model DiscordSpotlightAuditEvent {
  id                 String           @id @default(cuid())
  spotlightId        String
  actorDiscordUserId String
  action             String
  details            Json?
  createdAt          DateTime         @default(now())
  spotlight          DiscordSpotlight @relation(fields: [spotlightId], references: [id], onDelete: Cascade)

  @@index([spotlightId, createdAt])
}

/// A first-unlock-only record for a public, non-financial community badge.
model DiscordMemberAchievement {
  id             String                   @id @default(cuid())
  guildId        String
  discordUserId  String
  achievementKey String
  unlockedAt     DateTime                 @default(now())
  progression    DiscordMemberProgression @relation(fields: [guildId, discordUserId], references: [guildId, discordUserId], onDelete: Cascade)

  @@unique([guildId, discordUserId, achievementKey])
  @@index([guildId, discordUserId, unlockedAt])
}
