generator client {
  provider = "prisma-client-js"
}

generator discordBotClient {
  provider = "prisma-client-js"
  output   = "../../apps/discord-bot/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

