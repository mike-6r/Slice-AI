# Copy to server/.env for local runtime. Do not commit the local .env file.
NODE_ENV=development
# Explicit deployment intent. Set APP_ENV=beta for the controlled live Beta.
APP_ENV=development
# Provisioning-only Beta Admin inputs. Keep the password in the deployment secret store.
# BETA_ADMIN_EMAIL=beta-admin@example.com
# BETA_ADMIN_USERNAME=beta_admin
# BETA_ADMIN_PASSWORD=
# BETA_ADMIN_OPERATOR_EMAIL=existing-admin@example.com
# BETA_ADMIN_OPERATOR_PASSWORD=
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
SERVICE_VERSION=0.1.0
HTTP_BODY_LIMIT=1mb
# Number of directly trusted reverse-proxy hops. Keep 0 for direct local access.
TRUST_PROXY_HOPS=0

POSTGRES_DB=slice
POSTGRES_USER=slice_local
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://slice_local:replace-with-a-local-secret@127.0.0.1:5432/slice?schema=public
REDIS_URL=redis://127.0.0.1:6379
DB_CONNECT_TIMEOUT_MS=3000
REDIS_CONNECT_TIMEOUT_MS=3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=slice-api
JWT_AUDIENCE=slice-web
ACCESS_TOKEN_TTL_SECONDS=900
RECENT_AUTH_WINDOW_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=slice_refresh
# Production always requires true. Local HTTP development may set false.
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com

# Plaid Sandbox — backend only
PROVIDER_MODE=sandbox
PROVIDERS_PRODUCTION_ENABLED=false
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace-with-your-plaid-client-id
PLAID_SECRET=replace-with-your-plaid-secret
PLAID_IDV_TEMPLATE_ID=replace-with-your-plaid-idv-template-id

# Discord account linking — optional until Discord OAuth is configured. The backend stores only
# the Discord identity needed for the link, never OAuth access or refresh tokens.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/api/v1/auth/discord/callback
# Shared only with the Slice Discord bot deployment. Generate a separate 32+ character secret.
DISCORD_BOT_SERVICE_TOKEN=
# Guild used by the Accounts-panel bot-link fallback when Discord OAuth is not configured.
DISCORD_BOT_GUILD_ID=

# Auth communications. LOCAL_TEST is deterministic and non-networked; provider modes never
# fall back to it. APP_PUBLIC_URL is the trusted email-callback origin, never request Host.
EMAIL_DELIVERY_MODE=local_test
APP_PUBLIC_URL=http://127.0.0.1:5173
EMAIL_VERIFICATION_TTL_SECONDS=3600
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Slice
# Non-production only. Redirects transport delivery without changing the account email.
RESEND_TEST_RECIPIENT_OVERRIDE=

# Phone verification. `twilio_sms` uses Programmable Messaging as a transport;
# Slice remains the OTP authority. `twilio_verify` is the separate managed-proof mode.
# `local_test` is accepted only outside production.
PHONE_VERIFICATION_ENABLED=true
PHONE_DELIVERY_MODE=local_test
# For an opt-in Twilio Trial Programmable Messaging check, set:
# PHONE_DELIVERY_MODE=twilio_sms
PHONE_VERIFICATION_TTL_SECONDS=600
PHONE_VERIFICATION_RESEND_SECONDS=60
PHONE_VERIFICATION_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Required only for PHONE_DELIVERY_MODE=twilio_sms (E.164 Twilio trial/production sender).
TWILIO_FROM_NUMBER=
# Required only for PHONE_DELIVERY_MODE=twilio_verify.
TWILIO_VERIFY_SERVICE_SID=

# Signup CAPTCHA and consent. `local_test` is test-only; a real provider is
# deliberately fail-closed until an adapter and deployment-managed secrets are configured.
CAPTCHA_ENABLED=false
# CAPTCHA_PROVIDER=local_test|cloudflare_turnstile. The legacy CAPTCHA_* aliases are
# accepted during migration; TURNSTILE_* is the production configuration surface.
CAPTCHA_PROVIDER=local_test
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=signup
TURNSTILE_EXPECTED_HOSTNAME=localhost
# Development policy labels only; production must use approved legal references.
SIGNUP_CONSENT_REQUIRED=true
TERMS_POLICY_VERSION=terms-development-v1
PRIVACY_POLICY_VERSION=privacy-development-v1

# Two-factor authentication. Required in production; use a unique 32+ character secret.
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-32-plus-character-two-factor-key
TWO_FACTOR_CHALLENGE_TTL_SECONDS=300
TWO_FACTOR_ISSUER=Slice

PROVIDER_ENCRYPTION_KEY=replace-with-a-32-plus-character-non-production-key

# Keep external-provider credentials out of source control. Production startup fails closed when
# provider mode is explicitly enabled without the required credentials and encryption key.
BRIDGE_API_KEY=
BRIDGE_WEBHOOK_PUBLIC_KEY=
BLOCKCHAIN_ANALYSIS_API_KEY=

# PriceCharting API (server-only; paid subscription required for live calls)
PRICECHARTING_API_TOKEN=
PRICECHARTING_ENABLED=false
PRICECHARTING_BASE_URL=https://www.pricecharting.com
PRICECHARTING_MIN_REQUEST_INTERVAL_MS=1000
PRICECHARTING_CACHE_TTL_SECONDS=21600
PRICECHARTING_REQUEST_TIMEOUT_MS=10000

# Worker execution is opt-in and should run in a separately identified worker process.
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_ID=
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000

# Production defaults are fail-closed. Enable each new-risk surface explicitly through
# deployment-managed configuration; reads, cancellation and reconciliation remain available.
OPERATIONAL_TRADING_ENABLED=false
OPERATIONAL_DEPOSITS_ENABLED=false
OPERATIONAL_WITHDRAWALS_ENABLED=false
OPERATIONAL_REALTIME_ENABLED=false
OPERATIONAL_LISTING_ENABLED=false

# Disabled by default, including production. Set true only for an isolated staging
# environment to exercise the local, one-use submission upload capability. It is
# not an object-storage replacement and must stay false for production launch.
LOCAL_SUBMISSION_STORAGE_ENABLED=false

# Private submission evidence storage. LOCAL is for development/internal Beta only.
# S3_COMPATIBLE supports AWS S3, Cloudflare R2, and compatible endpoints.
OBJECT_STORAGE_PROVIDER=LOCAL
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRIVATE_PREFIX=private
OBJECT_STORAGE_PUBLIC_PREFIX=public
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
# Set only after the isolated provider probe succeeds; internal readiness telemetry.
OBJECT_STORAGE_LAST_PROBE_AT=
# Source root for the operator-controlled local-to-durable migration command.
LOCAL_SUBMISSION_STORAGE_ROOT=/var/lib/slice/submissions


# Only for disposable integration-test data. The database or schema must end in _test.
TEST_DATABASE_URL=postgresql://slice_local:replace-with-a-local-secret@127.0.0.1:5432/slice_test?schema=public_test
