{
  "name": "slice-api",
  "version": "0.1.0",
  "private": true,
  "description": "Slice API foundation. Phase 1 contains no financial or identity workflows.",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file=.env dist/main",
    "start:dev": "node --env-file=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "bootstrap:admin": "ts-node src/scripts/bootstrap-admin.ts",
    "seed:catalogue": "ts-node src/scripts/seed-catalogue-reference.ts",
    "qa:browser:seed": "ts-node src/scripts/seed-browser-qa.ts",
    "qa:browser:cleanup": "ts-node src/scripts/seed-browser-qa.ts --cleanup",
    "qa:finance": "ts-node src/scripts/manual-finance-qa.ts",
    "qa:community": "ts-node src/scripts/manual-community-governance-distribution-qa.ts",
    "qa:providers": "ts-node src/scripts/manual-provider-qa.ts",
    "qa:load": "ts-node src/scripts/local-load-check.ts",
    "staging:demo:setup": "ts-node src/scripts/setup-staging-demo.ts",
    "staging:demo:preflight": "ts-node src/scripts/preflight-staging-demo.ts",
    "staging:demo:refresh": "ts-node src/scripts/refresh-staging-demo.ts",
    "staging:demo:collector:refresh": "ts-node src/scripts/setup-demo-collector.ts",
    "staging:demo:market:check": "ts-node src/scripts/check-staging-demo-market.ts",
    "staging:demo:market:verify": "ts-node src/scripts/verify-staging-demo-market.ts",
    "staging:demo:vault-live:check": "ts-node src/scripts/check-staging-demo-vault-live.ts",
    "staging:demo:create-disposable-user": "ts-node src/scripts/create-staging-demo-disposable-user.ts",
    "staging:demo:verify-auth": "ts-node src/scripts/verify-staging-demo-auth.ts",
    "staging:beta:prepare": "ts-node src/scripts/prepare-live-beta.ts",
    "staging:beta:admin": "ts-node src/scripts/provision-beta-admin.ts",
    "beta:retire-fixtures": "ts-node src/scripts/retire-beta-fixtures.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:status": "prisma migrate status"
    ,"storage:migrate-local": "ts-node src/scripts/storage-migrate-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.10",
    "otplib": "12.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.2",
    "twilio": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.16.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  }
}
